#!/usr/bin/env bash
# ===================================================================== #
#  一键更新云服务器后端（Gitee 拉取 -> 依赖 -> 重启 -> 健康检查）
#
#  日常更新只需要:
#      ./.update
#
#  可选环境变量:
#      PORT=8000          后端端口（健康检查用）
#      PIP_INDEX_URL=...  自定义 pip 镜像（默认清华源）
#
#  前提（一次性）:
#      首次建议先跑 deploy/install-service.sh 注册 systemd 服务；
#      未注册时本脚本自动退回 start.sh/stop.sh 方式重启。
# ===================================================================== #
set -euo pipefail
cd "$(dirname "$0")"

PORT="${PORT:-8000}"
SERVICE_NAME="photo-rescue"
REQ_HASH_FILE="backend/.venv/.requirements.sha256"
SUDO=""
[ "$(id -u)" -ne 0 ] && command -v sudo >/dev/null 2>&1 && SUDO="sudo"

step() { printf '\n\033[1;36m==> %s\033[0m\n' "$*"; }
ok()   { printf '\033[1;32m[OK]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[警告]\033[0m %s\n' "$*"; }
die()  { printf '\033[1;31m[失败]\033[0m %s\n' "$*"; exit 1; }

# ---------------------------------------------------------------- 1. 拉代码
step "1/5 拉取 Gitee 最新代码"

command -v git >/dev/null 2>&1 || die "服务器没装 git（apt install git / yum install git）"
[ -d .git ] || die "当前目录不是 git 仓库。首次部署请先: git clone <你的Gitee仓库地址> ."

# 云服务器常见坑: root 操作了别人 clone 的仓库会报 dubious ownership，自动放行
if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    git config --global --add safe.directory "$(pwd)"
    git rev-parse --is-inside-work-tree >/dev/null 2>&1 \
        || die "git 仓库状态异常，请手动执行 git status 查看"
fi

BRANCH="$(git rev-parse --abbrev-ref HEAD)"
git fetch origin "$BRANCH" || die "git fetch 失败：检查服务器能否访问 gitee.com"

INCOMING="$(git log --oneline "HEAD..origin/$BRANCH" | head -5)"
if [ -z "$INCOMING" ]; then
    ok "已经是最新代码（$BRANCH）"
else
    echo "即将更新："
    echo "$INCOMING" | sed 's/^/    /'
fi

REQ_BEFORE="$(sha256sum requirements.txt 2>/dev/null | cut -d' ' -f1 || true)"

# 服务器上不该有本地改动；有也只提醒不覆盖
git pull --ff-only origin "$BRANCH" \
    || die "git pull 失败（本地有改动或分叉）。查看: git status；确认无误后: git checkout -- . 再跑本脚本"

REQ_AFTER="$(sha256sum requirements.txt 2>/dev/null | cut -d' ' -f1 || true)"

# ---------------------------------------------------------------- 2. 环境
step "2/5 检查运行环境"
if [ ! -x backend/.venv/bin/python ]; then
    command -v python3 >/dev/null 2>&1 || die "没找到 python3（apt install python3 python3-venv python3-pip）"
    echo "创建虚拟环境 backend/.venv ..."
    python3 -m venv backend/.venv || die "创建失败：Debian/Ubuntu 需要 apt install python3-venv"
fi
PY="backend/.venv/bin/python"

# 依赖：requirements 变化或缺失时才安装（平时秒过）
if [ "$REQ_BEFORE" != "$REQ_AFTER" ] || [ "$REQ_BEFORE" != "$(cat "$REQ_HASH_FILE" 2>/dev/null || echo '')" ] \
   || ! "$PY" -c "import uvicorn, fastapi, cv2, PIL, requests, multipart" >/dev/null 2>&1; then
    echo "安装/更新依赖（requirements.txt 有变化或首次部署）..."
    MIRROR="${PIP_INDEX_URL:-https://pypi.tuna.tsinghua.edu.cn/simple}"
    "$PY" -m pip install -q --disable-pip-version-check -r requirements.txt -i "$MIRROR" \
        || "$PY" -m pip install -q --disable-pip-version-check -r requirements.txt
fi

# OpenCV 在无桌面云服务器上常缺 libGL，能修则自动修
if ! "$PY" -c "import cv2" >/dev/null 2>&1; then
    warn "cv2 导入失败，尝试安装系统依赖（libGL）..."
    if command -v apt-get >/dev/null 2>&1; then
        $SUDO apt-get install -y -q libgl1 libglib2.0-0 >/dev/null 2>&1 || true
    elif command -v dnf >/dev/null 2>&1; then
        $SUDO dnf install -y -q mesa-libGL glib2 >/dev/null 2>&1 || true
    elif command -v yum >/dev/null 2>&1; then
        $SUDO yum install -y -q mesa-libGL glib2 >/dev/null 2>&1 || true
    fi
    "$PY" -c "import cv2" >/dev/null 2>&1 \
        || die "cv2 仍不可用。两个办法任选：\n  a) 手动装系统库: apt install libgl1 libglib2.0-0\n  b) 改用无头版: 把 requirements.txt 里 opencv-python 换成 opencv-python-headless"
fi
echo "$REQ_AFTER" > "$REQ_HASH_FILE" 2>/dev/null || true
ok "环境就绪"
bash deploy/ensure-fonts.sh "$PY"

# ---------------------------------------------------------------- 3. 重启
step "3/5 重启后端服务"
if command -v systemctl >/dev/null 2>&1 && systemctl list-unit-files 2>/dev/null | grep -q "^${SERVICE_NAME}.service"; then
    $SUDO systemctl restart "$SERVICE_NAME"
    ok "已通过 systemd 重启（journalctl -u $SERVICE_NAME -f 看日志）"
else
    warn "未注册 systemd 服务，用 start.sh/stop.sh 兜底（建议跑一次 deploy/install-service.sh）"
    bash stop.sh "$PORT" || true
    bash start.sh "$PORT"
fi

# ---------------------------------------------------------------- 4. 健康检查
step "4/5 健康检查"
HEALTH_OK=0
for _ in $(seq 1 15); do
    if curl -sf -m 3 "http://127.0.0.1:${PORT}/api/health" >/dev/null 2>&1; then
        HEALTH_OK=1
        break
    fi
    sleep 2
done
if [ "$HEALTH_OK" -ne 1 ]; then
    warn "健康检查未通过，看最近日志："
    if command -v systemctl >/dev/null 2>&1 && systemctl list-unit-files 2>/dev/null | grep -q "^${SERVICE_NAME}.service"; then
        $SUDO journalctl -u "$SERVICE_NAME" -n 30 --no-pager || true
    else
        tail -n 30 backend/logs/backend_*.log 2>/dev/null || true
    fi
    die "更新后服务未起来，按上面日志排查后可再次运行 ./.update"
fi
ok "服务健康: http://127.0.0.1:${PORT}/api/health"

# ---------------------------------------------------------------- 5. 完成
step "5/5 更新完成"
git log --oneline -1
echo "管理后台: http://127.0.0.1:${PORT}/admin"
