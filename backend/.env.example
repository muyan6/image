# 复制为 .env 后填写。.env 不要提交到 git。

# ---------------------------------------------------------------------------
# 管理后台（/admin）
# 留空 = 首次启动自动生成随机密码写回这里，并在后端日志里打印
# 改密码后需要重启服务生效（密码同时是登录 cookie 的签名密钥）
# ---------------------------------------------------------------------------
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# AI 供应商密钥现在统一在网页后台 /admin 里管理（backend/data/settings.json）。
# 这里只作为首次初始化的迁移来源：填了会自动导入后台，之后以后台为准。
#
#   fal.ai    https://fal.ai/dashboard/keys   格式 key_id:key_secret
#   百度智能云 https://console.bce.baidu.com/
#   中转网关（worldcodes.online / Sub2API 类）只在后台配置
#
# 下面留空也完全可以跑 —— 服务会自动降级到本地引擎。
# ---------------------------------------------------------------------------
FAL_KEY=
BAIDU_API_KEY=
BAIDU_SECRET_KEY=

# ---------------------------------------------------------------------------
# 服务参数（都有默认值，可以整段删掉）
# ---------------------------------------------------------------------------
# HOST=0.0.0.0
# PORT=8000
# RELOAD=0
# LOG_LEVEL=INFO
# WORKERS=4

# 上传限制
# MAX_UPLOAD_BYTES=26214400      # 25 MB
# MAX_PIXELS=60000000            # 6000 万像素

# 处理前把长边缩放到该值（也可在后台热调）。设为 0 关闭。
# NORMALIZE_LONG_SIDE=1536

# 任务保留时长（秒）与进程内最大任务数
# JOB_TTL_SECONDS=2592000        # 30 天
# JOB_MAX_ENTRIES=5000

# CORS 允许来源，逗号分隔。填 * 表示全放行（此时不允许携带 cookie）。
# 生产环境建议写成具体域名。
# ALLOWED_ORIGINS=https://your-domain.com,http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# 微信小程序登录（wx.login -> code2session）
# 也可在后台 /admin 的「平台与安全」里填，这里仅作首次迁移
# ---------------------------------------------------------------------------
# WX_APPID=wx1234567890abcdef
# WX_APP_SECRET=

# ---------------------------------------------------------------------------
# 腾讯云（内容审核 + COS 对象存储直传）
# 同样可后台填写；审核与 COS 共用这一对密钥
# ---------------------------------------------------------------------------
# TENCENT_SECRET_ID=AKID...
# TENCENT_SECRET_KEY=
