<view class="page-container">
 <view class="mine-header"><text class="eyebrow">创作者 · 我的模板</text><text class="headline">把好效果分享出去</text><text class="subtitle">审核通过后出现在模板库；修改新版需要重新审核，已审核旧版继续展示。</text><button class="primary" bindtap="onCreate">＋ 分享新模板</button></view>
 <view class="notice" wx:if="{{rewards}}">模板奖励累计 {{rewards.reward_earned}} 光子 · 实际到账 {{rewards.reward_credited}} 光子<text wx:if="{{rewards.recovery_due > 0}}">。退款奖励待冲正 {{rewards.recovery_due}} 光子，仅从之后的模板奖励抵扣，不扣除已有余额。</text></view>
 <view class="notice" wx:if="{{loading && !items.length}}">正在读取我的模板…</view>
 <view class="notice notice-error" wx:if="{{error}}"><text class="notice-error-message">{{error}}</text><button class="notice-retry" bindtap="onRetry">重试</button></view>
 <view class="mine-card" wx:for="{{items}}" wx:key="id"><image wx:if="{{item.coverUrl}}" class="mine-cover" src="{{item.coverUrl}}" mode="aspectFit" lazy-load /><view class="mine-info"><view class="mine-title-line"><text class="mine-title">{{item.name || '未命名草稿'}}</text><text class="status-tag">{{item.statusLabel}}</text></view><text class="mine-desc">{{item.subtitle || '尚未填写效果介绍'}}</text><text class="mine-meta">版本 {{item.revision}} · {{item.updatedLabel}}</text><text wx:if="{{item.has_published && item.status !== 'approved'}}" class="mine-meta">旧审核版仍在公开展示</text><text wx:if="{{item.reason}}" class="mine-reason">后台反馈：{{item.reason}}</text><view class="mine-actions"><button bindtap="onEdit" data-id="{{item.id}}">{{item.status === 'pending' ? '查看投稿' : '编辑模板'}}</button><button wx:if="{{item.has_published}}" bindtap="onView" data-template-id="{{item.template_id}}">查看公开版</button><button wx:if="{{item.status !== 'withdrawn'}}" bindtap="onWithdraw" data-id="{{item.id}}">撤回</button></view></view></view>
 <view wx:if="{{!loading && !error && !items.length}}" class="notice">还没有分享模板。上传封面与提示词，开始你的第一个模板。</view><button wx:if="{{hasMore}}" bindtap="onMore" loading="{{loading}}" disabled="{{loading}}">加载更多</button>
</view>
