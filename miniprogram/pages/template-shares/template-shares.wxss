.page-container{padding:36rpx 30rpx 70rpx;background:var(--paper-bg);min-height:100vh;box-sizing:border-box}.eyebrow,.headline,.subtitle,.mine-desc,.mine-meta,.mine-reason{display:block}.eyebrow{font-size:21rpx;color:var(--accent-gold);letter-spacing:3rpx}.headline{font-family:var(--font-serif);font-size:40rpx;font-weight:600;margin:16rpx 0}.subtitle{font-size:24rpx;line-height:1.8;color:var(--ink-muted)}button{font-size:24rpx;line-height:2.6;background:var(--paper-card);color:var(--ink-body);border:1rpx solid var(--paper-border);border-radius:6rpx}.primary{margin:24rpx 0 30rpx;padding:9rpx;background:var(--ink-title);color:var(--paper-bg)}.notice{margin:22rpx 0;padding:24rpx;background:var(--paper-card-subtle);font-size:24rpx;line-height:1.8;color:var(--ink-muted)}.mine-card{display:flex;gap:20rpx;align-items:flex-start;padding:24rpx;background:var(--paper-card);border:1rpx solid var(--paper-border);margin-bottom:20rpx}.mine-cover{width:150rpx;height:190rpx;flex-shrink:0;background:var(--paper-card-subtle)}.mine-info{flex:1;min-width:0}.mine-title-line{display:flex;gap:12rpx;align-items:flex-start;justify-content:space-between}.mine-title{font-family:var(--font-serif);font-size:28rpx;font-weight:600;overflow-wrap:anywhere}.status-tag{flex-shrink:0;border:1rpx solid var(--paper-border-dark);font-size:20rpx;padding:4rpx 8rpx;color:var(--accent-gold)}.mine-desc,.mine-meta,.mine-reason{font-size:23rpx;line-height:1.7;color:var(--ink-muted);margin-top:12rpx;overflow-wrap:anywhere}.mine-reason{color:var(--accent-rust)}.mine-actions{display:flex;gap:10rpx;flex-wrap:wrap;margin-top:18rpx}.mine-actions button{font-size:22rpx;margin:0;padding:0 14rpx;line-height:2.5}
.notice-error{display:flex;align-items:center;gap:16rpx;flex-wrap:wrap}
.notice-error-message{flex:1;min-width:0;word-break:break-word}
.notice-retry{box-sizing:border-box;display:inline-flex;align-items:center;justify-content:center;flex:0 0 auto;width:auto;min-width:96rpx;min-height:72rpx;margin:0;padding:0 22rpx;line-height:1.4}

.reward-card{border:1rpx solid var(--paper-border);background:var(--paper-card);padding:24rpx;margin:22rpx 0}
.reward-title,.reward-copy,.reward-rules{display:block}
.reward-title{font-size:30rpx;color:var(--accent-gold);font-weight:600;margin-bottom:12rpx}
.reward-copy{font-size:25rpx;line-height:1.8;color:var(--ink-body)}
.reward-rules{font-size:22rpx;line-height:1.8;color:var(--ink-muted);margin-top:12rpx}
.reward-card .notice-retry{margin-top:16rpx}
button{box-sizing:border-box;display:flex;align-items:center;justify-content:center;min-height:80rpx;border-radius:0;line-height:1.35;padding:12rpx 20rpx}
button::after{border:none}
.primary{width:100%;min-height:88rpx}
