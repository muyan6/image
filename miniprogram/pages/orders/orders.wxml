<view class="orders-page">
 <view class="summary"><text>充值订单</text><text>当前余额 ✦ {{balance}}</text></view>
 <text class="hint">到账以服务端核实为准。支付成功但未到账时，请点击核对；不会再次扣款。</text>
 <button bindtap="loadOrders" disabled="{{busy}}" loading="{{busy}}">刷新订单</button>
 <text wx:if="{{error}}" class="error">{{error}}</text>
 <view wx:if="{{!items.length && !busy}}" class="empty">暂无充值订单</view>
 <view class="order-card" wx:for="{{items}}" wx:key="id">
  <view class="row"><text>{{item.points}} 光子</text><text>{{item.priceText}}</text></view>
  <text class="status">{{item.statusLabel}}{{item.env === 1 ? ' · 沙箱订单' : ''}}</text>
  <text class="small">{{item.timeText}}</text><text class="small">订单号：{{item.id}}</text>
  <text wx:if="{{item.refunded_fen}}" class="small">已退款 {{item.refundText}} · 回收 {{item.reversed_points}} 光子</text>
  <text wx:if="{{item.error}}" class="hint">订单等待服务端核对，请稍后刷新</text>
  <button wx:if="{{item.status !== 'closed' && item.status !== 'refunded'}}" data-id="{{item.id}}" bindtap="onCheckOrder" disabled="{{busy}}">核对到账 / 退款</button>
 </view>
 <button bindtap="onGoCredits">返回光子中心</button>
</view>
