.orders-page{padding:32rpx;background:#f5f2eb;min-height:100vh;box-sizing:border-box;display:flex;flex-direction:column;gap:24rpx}.summary,.row{display:flex;justify-content:space-between;gap:20rpx}.summary{font-size:32rpx}.order-card{background:#fff;padding:28rpx;border:1rpx solid #ded9cf;display:flex;flex-direction:column;gap:16rpx}.status{font-weight:600}.hint,.small{font-size:24rpx;color:#777;line-height:1.6}.small{word-break:break-all}.empty{padding:60rpx;text-align:center;color:#777}.error{color:#a33}button{font-size:26rpx;margin:0}
