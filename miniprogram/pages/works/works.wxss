.page-container {
  background-color: var(--paper-bg);
  min-height: 100vh;
  padding: 30rpx 32rpx 80rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.works-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  padding: 0 4rpx;
}

.header-left {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.header-eyebrow {
  font-family: var(--font-mono);
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: var(--accent-gold);
}

.header-headline {
  font-family: var(--font-serif);
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ink-title);
  letter-spacing: 1rpx;
}

.header-sub {
  font-size: 22rpx;
  color: var(--ink-muted);
}

.clear-all-btn {
  font-size: 22rpx;
  color: var(--accent-rust);
  padding: 8rpx 16rpx;
}

/* 作品双列网格 */
.works-waterfall {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.work-card {
  background: #ffffff;
  border: 1rpx solid var(--paper-border);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: transform 0.15s ease;
}

.work-card:active {
  transform: translateY(2rpx);
}

.work-photo-box {
  width: 100%;
  height: 360rpx;
  position: relative;
  background: #ebe7de;
  overflow: hidden;
}

.work-img {
  width: 100%;
  height: 100%;
  display: block;
}

.work-quality-tag {
  position: absolute;
  bottom: 12rpx;
  left: 12rpx;
  background: rgba(26, 25, 23, 0.78);
  color: #f7f4ed;
  font-size: 22rpx;
  padding: 2rpx 10rpx;
  border-radius: 2rpx;
  backdrop-filter: blur(4px);
}

.work-info {
  padding: 18rpx 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1rpx solid var(--paper-border);
}

.work-date {
  font-family: var(--font-mono);
  font-size: 22rpx;
  color: var(--ink-muted);
}

.work-more-btn {
  font-size: 26rpx;
  color: var(--ink-muted);
  letter-spacing: 2rpx;
}

/* 空状态 */
.empty-state {
  background: #ffffff;
  border: 1rpx solid var(--paper-border);
  padding: 80rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  position: relative;
  margin-top: 40rpx;
}

.empty-symbol {
  font-size: 72rpx;
  color: var(--ink-faint);
  margin-bottom: 20rpx;
}

.empty-title {
  font-family: var(--font-serif);
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ink-title);
  margin-bottom: 10rpx;
}

.empty-desc {
  font-size: 22rpx;
  color: var(--ink-muted);
  line-height: 1.5;
  max-width: 480rpx;
  margin-bottom: 36rpx;
}

.empty-btn {
  padding: 20rpx 48rpx;
  font-size: 26rpx;
}

.work-processing-badge {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  background: rgba(22, 22, 24, 0.85);
  color: #ffb74d;
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  backdrop-filter: blur(4px);
}

.processing-dot {
  font-size: 14rpx;
  color: #ffb74d;
  animation: blinkDot 1.2s infinite;
}

@keyframes blinkDot {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.2; }
}

.work-filters { display: flex; gap: 10rpx; }
.work-filter { flex: 1; min-width: 0; border: 1rpx solid var(--paper-border); background: var(--paper-card-subtle);
  padding: 18rpx 4rpx; min-height: 80rpx; display: flex; align-items: center; justify-content: center; gap: 6rpx; font-size: 24rpx; color: var(--ink-body); }
.work-filter-active { border-color: var(--ink-title); background: var(--ink-title); color: var(--paper-bg); }
.work-filter-count { font-size: 22rpx; opacity: .8; }
.work-more-btn { min-width: 72rpx; min-height: 72rpx; display: flex; align-items: center; justify-content: flex-end; flex-shrink: 0; }
.work-info { gap: 8rpx; padding: 8rpx 16rpx; }
.work-date { min-width: 0; font-family: var(--font-sans); line-height: 1.5; }
