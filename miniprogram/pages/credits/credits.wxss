.page-container {
  background-color: var(--paper-bg);
  min-height: 100vh;
  padding: 30rpx 32rpx 80rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

/* 1. 可用积分主卡片 */
.balance-card {
  background: #ffffff;
  border: 1rpx solid var(--paper-border);
  padding: 40rpx 36rpx 30rpx;
  position: relative;
  box-shadow: 0 4rpx 20rpx rgba(40, 35, 25, 0.04);
}

.balance-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.balance-label {
  font-size: 24rpx;
  color: var(--ink-muted);
}

.rate-badge {
  font-size: 20rpx;
  color: var(--ink-faint);
  background: var(--paper-bg);
  padding: 4rpx 14rpx;
  border: 1rpx solid var(--paper-border);
}

.balance-main {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin: 16rpx 0 8rpx;
}

.balance-number {
  font-family: var(--font-serif);
  font-size: 72rpx;
  font-weight: 700;
  color: var(--ink-title);
  line-height: 1;
}

.balance-unit {
  font-size: 24rpx;
  color: var(--ink-muted);
}

.balance-desc {
  font-size: 22rpx;
  color: var(--ink-muted);
  display: block;
  margin-bottom: 24rpx;
}

.checkin-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx dashed var(--paper-border);
}

.checkin-status {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.check-icon {
  width: 32rpx;
  height: 32rpx;
  border-radius: 4rpx;
  background: #ebe6dc;
  color: var(--ink-title);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
}

.check-text {
  font-size: 24rpx;
  color: var(--ink-body);
  font-weight: 600;
}

.checkin-link {
  font-size: 22rpx;
  color: var(--ink-muted);
}

/* 2. 章节通用样式 */
.section-box {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 0 4rpx;
}

.section-title {
  font-family: var(--font-serif);
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink-title);
}

.section-tip {
  font-size: 20rpx;
  color: var(--ink-faint);
}

.package-list {
  background: #ffffff;
  border: 1rpx solid var(--paper-border);
}

.package-item {
  padding: 28rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.package-item:active {
  background: rgba(0, 0, 0, 0.02);
}

.pkg-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.pkg-name {
  font-family: var(--font-serif);
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink-title);
}

.badge-rec {
  font-size: 18rpx;
  background: var(--accent-rust);
  color: #ffffff;
  padding: 2rpx 10rpx;
  border-radius: 2rpx;
  font-weight: 500;
}

.pkg-sub {
  font-size: 20rpx;
  color: var(--ink-muted);
  margin-top: 4rpx;
  display: block;
}

.pkg-price-box {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.pkg-price {
  font-family: var(--font-serif);
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink-title);
}

.pkg-arrow {
  font-size: 28rpx;
  color: var(--ink-faint);
}

.item-divider {
  height: 1rpx;
  background: var(--paper-border);
  margin: 0 28rpx;
}

/* 3. 邀请横幅 */
.invite-banner {
  background: #ffffff;
  border: 1rpx solid var(--paper-border);
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.banner-badge {
  font-family: var(--font-serif);
  font-size: 26rpx;
  font-weight: 700;
  color: var(--accent-rust);
  background: rgba(158, 75, 60, 0.08);
  padding: 12rpx 16rpx;
  border-radius: 4rpx;
}

.banner-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.banner-title {
  font-family: var(--font-serif);
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink-title);
}

.banner-desc {
  font-size: 20rpx;
  color: var(--ink-muted);
  line-height: 1.35;
}

.banner-btn {
  padding: 14rpx 28rpx;
  font-size: 22rpx;
}

/* 4. 积分明细 */
.history-list {
  background: #ffffff;
  border: 1rpx solid var(--paper-border);
}

.history-item {
  padding: 24rpx 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid var(--paper-border);
}

.history-item:last-child {
  border-bottom: none;
}

.hist-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.hist-title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink-title);
}

.hist-time {
  font-size: 18rpx;
  color: var(--ink-faint);
}

.hist-gain {
  font-family: var(--font-serif);
  font-size: 26rpx;
  font-weight: 700;
  color: var(--accent-rust);
}

/* 5. 说明卡片 */
.notice-card {
  background: #ffffff;
  border: 1rpx solid var(--paper-border);
  padding: 24rpx 28rpx;
}

.notice-row {
  display: flex;
  gap: 18rpx;
  padding: 12rpx 0;
}

.notice-icon {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--ink-title);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.info-icon {
  background: #999388;
  font-family: var(--font-serif);
  font-style: italic;
}

.notice-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.notice-h {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--ink-title);
}

.notice-p {
  font-size: 20rpx;
  color: var(--ink-muted);
  line-height: 1.4;
}

.disclaimer-text {
  font-size: 18rpx;
  color: var(--ink-faint);
  text-align: center;
  display: block;
  margin-top: 8rpx;
}
