.page-container {
  background-color: var(--paper-bg);
  min-height: 100vh;
  padding: 30rpx 32rpx 80rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

/* 1. 可用积分主卡片 */
.balance-card {
  background: #ffffff;
  border: 1rpx solid var(--paper-border);
  padding: 40rpx 36rpx 30rpx;
  position: relative;
  box-shadow: 0 4rpx 20rpx rgba(40, 35, 25, 0.04);
}

.balance-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.balance-label {
  font-size: 24rpx;
  color: var(--ink-muted);
}

.rate-badge {
  font-size: 22rpx;
  color: var(--ink-faint);
  background: var(--paper-bg);
  padding: 4rpx 14rpx;
  border: 1rpx solid var(--paper-border);
}

.balance-main {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin: 16rpx 0 8rpx;
}

.balance-number {
  font-family: var(--font-serif);
  font-size: 72rpx;
  font-weight: 700;
  color: var(--ink-title);
  line-height: 1;
}

.balance-unit {
  font-size: 24rpx;
  color: var(--ink-muted);
}

.balance-desc {
  font-size: 22rpx;
  color: var(--ink-muted);
  display: block;
  margin-bottom: 24rpx;
}

.checkin-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx dashed var(--paper-border);
}

.checkin-status {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.check-icon {
  width: 32rpx;
  height: 32rpx;
  border-radius: 4rpx;
  background: #ebe6dc;
  color: var(--ink-title);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
}

.check-text {
  font-size: 24rpx;
  color: var(--ink-body);
  font-weight: 600;
}

.checkin-link {
  font-size: 22rpx;
  color: var(--ink-muted);
}

/* 2. 章节通用样式 */
.section-box {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 0 4rpx;
}

.section-title {
  font-family: var(--font-serif);
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink-title);
}

.section-tip {
  font-size: 22rpx;
  color: var(--ink-faint);
}

.package-list {
  background: #ffffff;
  border: 1rpx solid var(--paper-border);
}

.package-item {
  padding: 28rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.package-item:active {
  background: rgba(0, 0, 0, 0.02);
}

/* 订单入口作为套餐卡片的纸质页脚，与购买操作分开。 */
.orders-entry {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 26rpx 30rpx;
  min-height: 112rpx;
  border-top: 1rpx dashed var(--paper-border-dark);
  background: var(--paper-card-subtle);
}

.orders-entry-pressed {
  background: var(--paper-bg);
}

.orders-icon {
  width: 38rpx;
  height: 46rpx;
  flex-shrink: 0;
  border: 2rpx solid var(--accent-gold);
  padding: 12rpx 7rpx;
  display: flex;
  flex-direction: column;
  gap: 7rpx;
}

.orders-icon-line {
  height: 2rpx;
  width: 100%;
  flex-shrink: 0;
  background: var(--accent-gold);
}

.orders-icon-line-short {
  width: 65%;
}

.orders-entry-content {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.orders-entry-title {
  font-family: var(--font-serif);
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink-title);
  line-height: 1.4;
}

.orders-entry-desc {
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--ink-muted);
}

.orders-entry-arrow {
  flex-shrink: 0;
  font-size: 36rpx;
  line-height: 1;
  color: var(--ink-faint);
  padding-left: 8rpx;
}

.pkg-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.pkg-name {
  font-family: var(--font-serif);
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink-title);
}

.badge-rec {
  font-size: 22rpx;
  background: var(--accent-rust);
  color: #ffffff;
  padding: 2rpx 10rpx;
  border-radius: 2rpx;
  font-weight: 500;
}

.pkg-sub {
  font-size: 22rpx;
  color: var(--ink-muted);
  margin-top: 4rpx;
  display: block;
}

.pkg-price-box {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.pkg-price {
  font-family: var(--font-serif);
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink-title);
}

.pkg-arrow {
  font-size: 28rpx;
  color: var(--ink-faint);
}

.item-divider {
  height: 1rpx;
  background: var(--paper-border);
  margin: 0 28rpx;
}

/* 3. 邀请横幅 */
.invite-banner {
  background: #ffffff;
  border: 1rpx solid var(--paper-border);
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.banner-badge {
  font-family: var(--font-serif);
  font-size: 26rpx;
  font-weight: 700;
  color: var(--accent-rust);
  background: rgba(158, 75, 60, 0.08);
  padding: 12rpx 16rpx;
  border-radius: 4rpx;
}

.banner-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.banner-title {
  font-family: var(--font-serif);
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink-title);
}

.banner-desc {
  font-size: 22rpx;
  color: var(--ink-muted);
  line-height: 1.35;
}

.banner-btn {
  padding: 14rpx 28rpx;
  font-size: 22rpx;
}

/* 4. 积分明细 */
.history-list {
  background: #ffffff;
  border: 1rpx solid var(--paper-border);
}

.history-item {
  padding: 24rpx 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid var(--paper-border);
}

.history-item:last-child {
  border-bottom: none;
}

.hist-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.hist-title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--ink-title);
}

.hist-time {
  font-size: 22rpx;
  color: var(--ink-faint);
}

.hist-gain {
  font-family: var(--font-serif);
  font-size: 26rpx;
  font-weight: 700;
  color: var(--accent-rust);
}

/* 5. 说明卡片 */
.notice-card {
  background: #ffffff;
  border: 1rpx solid var(--paper-border);
  padding: 24rpx 28rpx;
}

.notice-row {
  display: flex;
  gap: 18rpx;
  padding: 12rpx 0;
}

.notice-icon {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--ink-title);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.info-icon {
  background: #999388;
  font-family: var(--font-serif);
  font-style: italic;
}

.notice-text {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.notice-h {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--ink-title);
}

.notice-p {
  font-size: 22rpx;
  color: var(--ink-muted);
  line-height: 1.4;
}

.disclaimer-text {
  font-size: 22rpx;
  color: var(--ink-faint);
  text-align: center;
  display: block;
  margin-top: 8rpx;
}

.checkin-mask { position: fixed; inset: 0; z-index: 400; display: flex; align-items: flex-end;
  background: rgba(20, 19, 18, .5); }
.checkin-sheet { box-sizing: border-box; width: 100%; max-height: 88vh; overflow-y: auto;
  padding: 18rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
  border-radius: 36rpx 36rpx 0 0; background: #faf8f3; }
.checkin-grip { width: 68rpx; height: 8rpx; border-radius: 10rpx; background: #d7d3cc;
  margin: 0 auto 30rpx; }
.checkin-head { display: flex; align-items: flex-start; justify-content: space-between; }
.checkin-eyebrow { display: block; font-size: 19rpx; letter-spacing: 3rpx; color: #9e4b3c; }
.checkin-title { display: block; font-size: 40rpx; font-weight: 700; color: #1a1917; margin-top: 4rpx; }
.checkin-close { font-size: 32rpx; color: #777168; padding: 4rpx 8rpx; }
.checkin-subtitle { display: block; color: #8b857b; font-size: 23rpx; margin: 14rpx 0 26rpx; }
.checkin-reward-card { background: #1b1b1c; color: #fff; border-radius: 22rpx;
  padding: 28rpx 30rpx; display: flex; justify-content: space-between; align-items: center; }
.checkin-reward-label { display: block; font-size: 19rpx; color: #a5a2a0; letter-spacing: 2rpx; }
.checkin-reward-amount { display: block; font-size: 48rpx; font-weight: 700; margin: 6rpx 0; }
.checkin-unit { font-size: 22rpx; color: #c8c4bf; }
.checkin-bonus-hint { display: block; font-size: 21rpx; color: #a5a2a0; }
.checkin-streak { width: 106rpx; height: 106rpx; border: 2rpx solid #636060; border-radius: 50%;
  display: flex; flex-direction: column; align-items: center; justify-content: center; }
.checkin-streak text:first-child { font-size: 36rpx; font-weight: 700; line-height: 1; }
.checkin-streak text:last-child { font-size: 17rpx; color: #a5a2a0; }
.checkin-progress-head { display: flex; justify-content: space-between; margin: 30rpx 4rpx 20rpx;
  font-size: 24rpx; font-weight: 700; color: #1a1917; }
.checkin-progress-head text:last-child { color: #9e4b3c; }
.checkin-days { display: flex; justify-content: space-between; gap: 4rpx; }
.checkin-day { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.checkin-day-label { font-size: 16rpx; color: #9b958c; white-space: nowrap; }
.checkin-day-circle { width: 68rpx; height: 68rpx; border: 2rpx solid #dedbd4; border-radius: 50%;
  display: flex; align-items: center; justify-content: center; background: #faf8f3;
  color: #777168; font-size: 27rpx; }
.checkin-done { background: #9e4b3c; border-color: #9e4b3c; color: #fff; }
.checkin-today { border: 4rpx solid #1a1917; color: #1a1917; }
.checkin-bonus { color: #9e4b3c; border-color: #d7ba82; }
.checkin-bonus.checkin-done { color: #fff; border-color: #9e4b3c; }
.checkin-day-caption { font-size: 17rpx; color: #a29b92; white-space: nowrap; }
.checkin-progress-tip { display: block; color: #8b857b; font-size: 21rpx; margin: 26rpx 4rpx; }
.checkin-claim { width: 100%; height: 82rpx; line-height: 82rpx; border-radius: 18rpx;
  background: #1a1917; color: #fff; font-size: 27rpx; font-weight: 700; }
.checkin-claim[disabled] { background: #d7d3cc; color: #777168; }

.pkg-sub, .banner-desc, .orders-entry-desc, .notice-p { font-size: 24rpx; line-height: 1.55; }
.pkg-info { min-width: 0; }
.pkg-price-box { flex-shrink: 0; }
.package-item { gap: 20rpx; }
.banner-content { min-width: 0; }
.banner-btn { flex-shrink: 0; min-width: 108rpx; }
.checkin-day-label, .checkin-day-caption { font-size: 20rpx; }
