<view class="page-container">
  <!-- 1. 可用光子主卡片 (Museum Mat Board) -->
  <view class="balance-card gallery-card">
    <view class="washi-tape"></view>
    <view class="balance-head">
      <text class="balance-label">可用光子</text>
      <text class="rate-badge">生成 · ✦{{ costPerGeneration }}/张</text>
    </view>
    <view class="balance-main">
      <text class="balance-number">✦ {{ lightPoints }}</text>
      <text class="balance-unit">光子</text>
    </view>
    <text class="balance-desc">当前余额约可生成 {{ estimatedGenerations }} 张照片</text>

    <view class="checkin-row" bindtap="onOpenCheckin">
      <view class="checkin-status">
        <text class="check-icon">{{ checkedIn ? '✓' : '✦' }}</text>
        <text class="check-text">{{ checkedIn ? '今日已签到' : '每日签到领 ✦' + checkinReward }}</text>
      </view>
      <text class="checkin-link">查看签到日历 ›</text>
    </view>
  </view>

  <!-- 2. 充值光子 -->
  <view class="section-box">
    <view class="section-head">
      <text class="section-title">充值光子</text>
      <text class="section-tip">{{ paymentBusy ? '订单处理中…' : (catalogLoading || catalogStale ? '正在更新套餐…' : (paymentReady ? '选择套餐充值' : '充值暂未启用')) }}</text>
    </view>

    <view class="catalog-message" wx:if="{{ catalogError }}" bindtap="refreshCatalog"><text>{{ catalogError }}</text><text>↻</text></view>
    <view class="package-list gallery-card">
      <view class="catalog-empty" wx:if="{{ !packages.length }}">{{ catalogLoading ? '正在读取最新套餐…' : '暂无可购买套餐' }}</view>
      <block wx:for="{{ packages }}" wx:key="id">
      <view class="package-item {{ item.promotionVisible ? 'package-promotion' : '' }} {{ catalogStale ? 'package-stale' : '' }}" bindtap="onSelectPackage" data-id="{{ item.id }}">
        <view class="pkg-info">
          <view class="pkg-title-row"><text class="pkg-name">{{ item.points }} 光子</text>
            <text class="pkg-promotion-tag" wx:if="{{ item.promotionVisible }}">{{ item.promotionLabel }}</text></view>
          <text class="pkg-sub">{{ item.bonus_text }} · 约 {{ item.generations }} 张</text>
          <view class="pkg-countdown" wx:if="{{ item.promotionVisible }}"><text class="pkg-countdown-dot"></text><text>距结束</text><text class="pkg-countdown-value">{{ item.countdownText }}</text></view>
        </view>
        <view class="pkg-price-box">
          <view class="pkg-price-stack"><text class="pkg-original-price" wx:if="{{ item.originalPrice }}">{{ item.originalPrice }}</text>
            <text class="pkg-price {{ item.promotionVisible ? 'pkg-sale-price' : '' }}">{{ item.price_text }}</text></view>
          <text class="pkg-arrow">›</text>
        </view>
      </view>
      <view class="item-divider" wx:if="{{ index < packages.length - 1 }}"></view>
      </block>
      <view class="orders-entry" hover-class="orders-entry-pressed" hover-stay-time="120" bindtap="onGoOrders">
        <view class="orders-icon" aria-hidden="true">
          <view class="orders-icon-line"></view>
          <view class="orders-icon-line orders-icon-line-short"></view>
        </view>
        <view class="orders-entry-content">
          <text class="orders-entry-title">充值订单</text>
          <text class="orders-entry-desc">查看充值记录 · 核对到账</text>
        </view>
        <text class="orders-entry-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 3. 邀请好友得光子卡片 -->
  <view class="invite-banner gallery-card" bindtap="onGoInvite">
    <view class="banner-badge">✦{{ inviteReward }}</view>
    <view class="banner-content">
      <text class="banner-title">邀请好友</text>
      <text class="banner-desc">好友绑定你的邀请码后，你和对方各得 {{ inviteReward }} 光子。</text>
    </view>
    <button class="btn-ink banner-btn">邀请</button>
  </view>

  <!-- 4. 光子明细 -->
  <view class="section-box">
    <view class="section-head">
      <text class="section-title">光子明细</text>
    </view>
    <view class="history-list gallery-card">
      <view class="history-item" wx:if="{{ records.length === 0 }}">
        <text class="hist-title">暂无光子明细；余额以服务端为准。</text>
      </view>
      <view class="history-item" wx:for="{{ records }}" wx:key="id">
        <view class="hist-info">
          <text class="hist-title">{{ item.title }}</text>
          <text class="hist-time">{{ item.time }}</text>
        </view>
        <text class="hist-gain">✦{{ item.amount }}</text>
      </view>
    </view>
  </view>

  <!-- 5. 使用说明 -->
  <view class="section-box">
    <view class="section-head">
      <text class="section-title">使用说明</text>
    </view>
    <view class="notice-card gallery-card">
      <view class="notice-row">
        <view class="notice-icon">✓</view>
        <view class="notice-text">
          <text class="notice-h">失败不扣光子</text>
          <text class="notice-p">技术失败或超时会退回预扣光子；明确违规内容不予生成，本次点数不退。</text>
        </view>
      </view>
      <view class="item-divider"></view>
      <view class="notice-row">
        <view class="notice-icon info-icon">i</view>
        <view class="notice-text">
          <text class="notice-h">官方虚拟支付与订单退款</text>
          <text class="notice-p">光子是图片生成权益，使用官方虚拟支付道具直购；iOS 由 Apple 收款，其他终端由微信收款。iOS 订单退款请向 App Store 申请，由 Apple 决定；其他终端请联系客服核对后通过微信平台处理。退款完成后按比例回收对应光子。</text>
        </view>
      </view>
      <view class="item-divider"></view>
      <view class="notice-row">
        <view class="notice-icon info-icon">i</view>
        <view class="notice-text">
          <text class="notice-h">个人主体支付规则</text>
          <text class="notice-p">个人主体全终端月支付限额为 10 万元，以微信平台统计为准。商户承担支付服务费：Android 等终端 1%，iOS 12%，用户以收银台金额为准，不另加收此费用。Android 等终端通常 T+3 结算，iOS 约 45–60 天，结算周期不影响已核实订单的光子到账。</text>
        </view>
      </view>
      <view class="item-divider"></view>
      <view class="notice-row">
        <view class="notice-icon info-icon">i</view>
        <view class="notice-text">
          <text class="notice-h">生成效果退款规则</text>
          <text class="notice-p">明显技术异常可申诉；仅因主观不喜欢不支持退款。</text>
        </view>
      </view>
    </view>
    <text class="disclaimer-text">光子为虚拟权益，仅用于本小程序内的图片生成与风格重塑服务。</text>
  </view>

  <view class="checkin-mask" wx:if="{{ showCheckinSheet }}" bindtap="onCloseCheckin">
    <view class="checkin-sheet" catchtap="true">
      <view class="checkin-grip"></view>
      <view class="checkin-head">
        <view><text class="checkin-eyebrow">DAILY STUDIO</text><text class="checkin-title">每日签到</text></view>
        <text class="checkin-close" bindtap="onCloseCheckin">✕</text>
      </view>
      <text class="checkin-subtitle">连续 7 天，解锁本周额外奖励</text>
      <view class="checkin-reward-card">
        <view><text class="checkin-reward-label">TODAY REWARD</text>
          <text class="checkin-reward-amount">+{{ checkinReward }}<text class="checkin-unit"> 光子</text></text>
          <text class="checkin-bonus-hint">第 7 天额外获得 {{ checkinBonus }} 光子</text></view>
        <view class="checkin-streak"><text>{{ checkinStreak }}</text><text>连续天数</text></view>
      </view>
      <view class="checkin-progress-head"><text>本周进度</text><text>{{ checkinProgress }}/7</text></view>
      <view class="checkin-days">
        <view class="checkin-day" wx:for="{{ checkinDays }}" wx:key="day">
          <text class="checkin-day-label">{{ item.bonus ? 'BONUS' : 'DAY ' + item.day }}</text>
          <view class="checkin-day-circle {{ item.done ? 'checkin-done' : (item.today ? 'checkin-today' : '') }} {{ item.bonus ? 'checkin-bonus' : '' }}">{{ item.done ? '✓' : (item.bonus ? '★' : item.day) }}</view>
          <text class="checkin-day-caption">{{ item.done ? '已签' : (item.today ? '今天' : (item.bonus ? '+' + checkinBonus : '+' + checkinReward)) }}</text>
        </view>
      </view>
      <text class="checkin-progress-tip">{{ checkedIn ? '今天已签到，明天继续保持。' : '完成今天的签到，奖励会立即计入余额。' }}</text>
      <button class="checkin-claim" bindtap="onCheckIn" disabled="{{ checkedIn || checkinBusy }}" loading="{{ checkinBusy }}">{{ checkedIn ? '今日已签到' : '签到领取 ' + checkinReward + ' 光子' }}</button>
    </view>
  </view>
</view>
