<view class="page-container">
  <!-- 顶部极简中文栏 -->
  <view class="nav-bar">
    <view class="nav-brand">
      <image class="brand-logo" src="/images/logo.jpg" mode="aspectFit"></image>
      <text class="brand-name">废片新生所</text>
    </view>
    <view class="credit-pill" bindtap="onOpenCreditModal">
      <text class="credit-icon">✦</text>
      <text class="credit-text" wx:if="{{ freeMode }}">光子不限量</text>
      <text class="credit-text" wx:else>{{ lightPoints }} 光子</text>
      <text class="credit-add" wx:if="{{ !freeMode }}">+</text>
    </view>
  </view>

  <!-- 公告横幅 (如有) -->
  <view wx:if="{{ notice }}" class="notice-strip" bindtap="onTapNotice">
    <text class="notice-tag">公告</text>
    <text class="notice-title">{{ notice.title }}</text>
    <text class="notice-arrow">›</text>
  </view>

  <!-- 待使用的风格（从模板库/社区「做同款」带过来） -->
  <view class="home-task-card" wx:if="{{pendingCount}}" bindtap="onOpenPendingTasks"><text class="home-task-title">{{pendingCount}} 件作品正在生成 ›</text><text class="home-task-desc">{{pendingSummary}} · 可以继续创作</text></view>
  <view class="home-task-card" wx:if="{{finishedText}}" bindtap="onOpenFinishedTask"><text class="home-task-title">{{finishedText}} ›</text></view>
  <view class="home-task-error" wx:if="{{taskError}}" bindtap="loadPendingTasks">{{taskError}}</view>
  <view class="home-draft-card" wx:if="{{draftSummary}}" bindtap="onResumeDraft"><text>{{draftSummary}}</text><text>恢复草稿 ›</text></view>
  <view wx:if="{{ activeTemplate }}" class="pending-template" bindtap="onClearTemplate">
    <text class="pending-template-text">已选风格 · {{ activeTemplate.name }}</text>
    <text class="pending-template-clear">✕</text>
  </view>

  <!-- 初始空白待选图状态 -->
  <view class="state-empty-wrap">
    <!-- 标语区 (优雅中文诗意排版) -->
    <view class="intro-section">
      <text class="eyebrow">旧日瞬间 · 重现眼前</text>
      <text class="headline">让这一刻，重获新生</text>
      <text class="subhead">修复光影 · 留住真实 · 细节重构</text>
    </view>

    <!-- 核心选图卡片 (带艺术纸质与和纸胶带) -->
    <view class="upload-portal gallery-card" bindtap="onPickImage">
      <view class="washi-tape"></view>
      <view class="portal-body">
        <view class="portal-btn">
          <text class="portal-btn-title">选择照片</text>
          <text class="portal-btn-arrow">→</text>
        </view>
        <view class="home-quick-actions">
          <button class="home-quick-action home-text-action" catchtap="onOpenTextGeneration">
            <text class="quick-action-label">文字生图</text><text class="quick-action-arrow" aria-hidden="true">→</text>
          </button>
          <button class="home-quick-action home-work-action" catchtap="onOpenHistory">
            <text class="quick-action-label">我的作品<text wx:if="{{ historyCount > 0 }}">（{{ historyCount }}）</text></text><text class="quick-action-arrow" aria-hidden="true">→</text>
          </button>
        </view>
        <text class="portal-hint">相册 / 拍照 · JPG、PNG、WebP</text>
      </view>
    </view>

    <text class="generation-warning">请勿上传违规内容：审核违规不予生图并扣除本次点数；7天内累计3次将永久封禁账号，剩余点数不予退还。</text>

    <!-- 热门风格 · 当前启用模板 -->
    <view class="showcase-section">
      <view class="showcase-header">
        <view class="showcase-title-wrap">
          <text class="showcase-title">热门风格</text>
          <text class="showcase-subtitle">按使用热度排序</text>
        </view>
        <view class="showcase-link" bindtap="onGoToTemplates">
          <text>查看全部风格</text>
          <text class="link-arrow">›</text>
        </view>
      </view>

      <scroll-view class="showcase-scroll" scroll-x enable-flex show-scrollbar="{{ false }}">
        <view
          wx:for="{{ featuredTemplates }}"
          wx:key="id"
          class="showcase-card gallery-card"
          bindtap="onSelectFeaturedTemplate"
          data-template="{{ item }}"
        >
          <view class="showcase-cover-wrap">
            <image
              bindload="onFeaturedImageLoad" data-id="{{item.id}}"
              class="showcase-cover"
              src="{{ item.coverUrl || '/images/logo.jpg' }}"
              mode="aspectFit"
            ></image>
            <view class="showcase-tag">
              <text>轻量 / 精细可选</text>
            </view>
          </view>
          <view class="showcase-info">
            <text class="showcase-name">{{ item.name }}</text>
            <text class="showcase-desc">{{ item.subtitle }}</text>
            <view class="showcase-foot">
              <text class="showcase-cost">{{ item.costText || (item.price > 0 ? '✦ ' + item.price + ' 光子' : '✦ 40 光子') }}</text>
              <text class="showcase-action">使用 ›</text>
            </view>
          </view>
        </view>
      </scroll-view>
      <view wx:if="{{!featuredTemplates.length}}" class="showcase-empty">{{templateError || '暂无可用风格，稍后再来看看'}}</view>
    </view>
  </view>
</view>
