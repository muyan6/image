<view class="page-container">
  <!-- 顶部策展栏 -->
  <view class="salon-header">
    <text class="salon-eyebrow">废片新生所 · 灵感沙龙</text>
    <text class="salon-headline">看看大家的作品</text>
    <text class="salon-desc">发现喜欢的效果，试试同款风格</text>
  </view>

  <!-- 展区筛选胶囊：没有展品时不显示筛选条 -->
  <scroll-view
    wx:if="{{ items.length > 0 }}"
    class="salon-filter-bar"
    scroll-x
    enable-flex
    show-scrollbar="{{ false }}"
  >
    <view
      wx:for="{{ filters }}"
      wx:key="id"
      class="filter-chip {{ activeFilter === item.id ? 'filter-chip-active' : '' }}"
      bindtap="onSelectFilter"
      data-id="{{ item.id }}"
    >
      <text class="filter-chip-text">{{ item.name }}</text>
    </view>
  </scroll-view>

  <!-- 沙龙暂停开放：后端 community.enabled = false -->
  <view wx:if="{{ !loading && !enabled }}" class="salon-empty gallery-card">
    <text class="empty-title">沙龙正在布展中</text>
    <text class="empty-desc">灵感沙龙暂未开放，稍后再来看看。</text>
  </view>

  <!-- 已开放但暂无展品 -->
  <view wx:elif="{{ !loading && items.length === 0 }}" class="salon-empty gallery-card">
    <text class="empty-title">展厅暂无展品</text>
    <text class="empty-desc">完成一次创作后，作品就有机会被收录进沙龙。</text>
  </view>

  <!-- 社区展品卡片流 -->
  <view class="showcase-list">
    <view
      wx:for="{{ filteredItems }}"
      wx:key="id"
      class="exhibit-card gallery-card"
    >
      <view class="washi-tape" wx:if="{{ index === 0 }}"></view>

      <!-- 策展人与作者信息 -->
      <view class="exhibit-head">
        <view class="author-wrap">
          <image class="author-avatar" src="{{ item.authorAvatar || '/images/logo.jpg' }}" mode="aspectFill"></image>
          <view class="author-meta">
            <text class="author-name">{{ item.authorName }}</text>
            <text class="author-time">{{ item.date }} · {{ item.categoryName }}</text>
          </view>
        </view>
        <view class="recipe-badge">
          <text class="recipe-tag">配方</text>
          <text class="recipe-name">{{ item.templateName }}</text>
        </view>
      </view>

      <!-- 双图对比展框 (原图 vs 新生图) -->
      <view class="compare-frame">
        <view class="frame-photo-box" bindtap="onPreviewExhibit" data-item="{{ item }}" data-type="result">
          <image class="frame-photo" src="{{ item.resultUrl }}" mode="aspectFill" lazy-load></image>
          <view class="frame-tag frame-tag-after">{{ item.quality === 'fine' ? '精细生成' : '轻量生成' }}</view>
        </view>
        <view class="frame-photo-box frame-photo-before" bindtap="onPreviewExhibit" data-item="{{ item }}" data-type="original">
          <image class="frame-photo" src="{{ item.origUrl }}" mode="aspectFill" lazy-load></image>
          <view class="frame-tag frame-tag-before">修护前原片</view>
        </view>
      </view>

      <!-- 作品故事与题跋 -->
      <view class="exhibit-body">
        <text class="exhibit-title">{{ item.title }}</text>
        <text class="exhibit-story">{{ item.story }}</text>
      </view>

      <!-- 底部互动与一键【做同款】 -->
      <view class="exhibit-foot">
        <view class="interaction-group">
          <view class="like-btn {{ item.liked ? 'like-btn-active' : '' }}" bindtap="onLikeItem" data-id="{{ item.id }}">
            <text class="like-icon">{{ item.liked ? '♥' : '♡' }}</text>
            <text class="like-count">{{ item.likes }}</text>
          </view>
          <view class="share-pill" bindtap="onShareExhibit" data-title="{{ item.title }}" data-result-url="{{ item.resultUrl }}">
            <text class="share-icon">↗</text>
            <text class="share-text">分享</text>
          </view>
        </view>

        <button class="btn-ink make-same-btn" bindtap="onMakeSame" data-template-id="{{ item.templateId }}" data-name="{{ item.templateName }}">
          做同款风格 →
        </button>
      </view>
    </view>
  </view>

  <!-- 底部装裱签条 -->
  <view class="salon-footer">
    <view class="footer-divider"></view>
    <text class="footer-note">欢迎将您的重生之作投稿至沙龙 · 每期精选赠送 ✦{{ featuredReward }} 光子</text>
  </view>
</view>
