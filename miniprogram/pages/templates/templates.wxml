<view class="page-container">
  <!-- 顶部策展导语 -->
  <view class="catalog-header">
    <text class="catalog-eyebrow">废片新生所 · 风格图鉴</text>
    <text class="catalog-headline">选一个喜欢的风格</text>
    <text class="catalog-desc">上传照片即可使用 · 生成前可选轻量或精细档位</text>
  </view>

  <view class="template-search">
    <view class="search-icon" aria-hidden="true"><view class="search-lens"></view><view class="search-handle"></view></view>
    <input class="search-input" value="{{ searchQuery }}" maxlength="40" confirm-type="search"
      placeholder="搜索模板名称、风格或关键词" bindinput="onSearchInput" />
    <view class="search-clear" wx:if="{{ searchQuery }}" bindtap="onClearSearch">清除</view>
  </view>

  <!-- 分类筛选项 (艺术纸本印泥胶囊) -->
  <view class="preference-bar"><view class="preference-chip {{preferenceMode === 'all' ? 'preference-active' : ''}}" data-id="all" bindtap="onPreferenceFilter">全部模板</view><view class="preference-chip {{preferenceMode === 'favorites' ? 'preference-active' : ''}}" data-id="favorites" bindtap="onPreferenceFilter">我的收藏</view><view class="preference-chip {{preferenceMode === 'recent' ? 'preference-active' : ''}}" data-id="recent" bindtap="onPreferenceFilter">最近使用</view></view>
  <view wx:if="{{preferencesError}}" class="ui-inline-state catalog-state"><text class="catalog-state-message">{{preferencesError}}</text><button class="ui-state-action catalog-retry" bindtap="loadPreferences">重试</button></view>
  <view wx:if="{{preferencesLoading && preferenceMode !== 'all'}}" class="ui-inline-state"><text>正在同步收藏与最近使用…</text></view>
  <scroll-view class="category-bar" scroll-x enable-flex show-scrollbar="{{ false }}">
    <view
      wx:for="{{ categories }}"
      wx:key="id"
      class="cat-chip {{ activeCategory === item.id ? 'cat-chip-active' : '' }}"
      bindtap="onSelectCategory"
      data-id="{{ item.id }}"
    >
      <text class="cat-chip-text">{{ item.id === 'all' ? '全部' : item.name }}</text>
      <text class="cat-chip-count" wx:if="{{ item.count > 0 }}">({{ item.count }})</text>
    </view>
  </scroll-view>
  <view class="catalog-sort" wx:if="{{activeCategory === 'all' && preferenceMode !== 'recent'}}">
    <view wx:for="{{sortModes}}" wx:key="id" class="sort-chip {{sortMode === item.id ? 'sort-active' : ''}}" bindtap="onSortMode" data-id="{{item.id}}">{{item.name}}</view>
    <button wx:if="{{sortMode === 'random'}}" class="sort-shuffle" bindtap="onShuffleTemplates">换一批</button>
  </view>

  <!-- 模板展柜卡片流 (双列艺术画框网格) -->
  <view wx:if="{{ loadError }}" class="ui-inline-state catalog-state">
    <text class="catalog-state-message">{{ allTemplates.length ? '更新失败，当前展示已缓存的模板' : loadError }}</text>
    <button class="ui-state-action catalog-retry" bindtap="onRetryTemplates">重试</button>
  </view>
  <view wx:if="{{ loading && !allTemplates.length }}" class="templates-grid skeleton-grid" aria-label="正在加载模板">
    <view class="skeleton-card" wx:for="{{ skeletonItems }}" wx:key="*this">
      <view class="skeleton-cover"></view><view class="skeleton-line"></view><view class="skeleton-line skeleton-short"></view>
    </view>
  </view>
  <view class="templates-grid">
    <view
      wx:for="{{ filteredTemplates }}"
      wx:key="id"
      class="template-card gallery-card"
      bindtap="onOpenDetail"
      data-template="{{ item }}"
    >
      <view class="card-cover-box">
        <text class="card-source-badge {{item.source === 'user' ? 'source-user' : ''}}">{{item.sourceLabel}}</text>
        <image
          class="card-cover-img"
          src="{{ item.coverUrl || '/images/logo.jpg' }}"
          mode="aspectFit"
          lazy-load
          bindload="onTemplateImageLoad" binderror="onTemplateImageError" data-id="{{item.id}}"
        ></image>
        <view class="card-multi-badge" wx:if="{{ item.covers && item.covers.length > 1 }}">
          <text>{{ item.covers.length }}图</text>
        </view>
      </view>

      <view class="card-content">
        <view class="card-name-row">
          <text class="card-name">{{ item.name }}</text>
          <button class="favorite-btn {{item.favorite ? 'favorite-active' : ''}}" catchtap="onFavorite" data-id="{{item.id}}" aria-label="{{item.favorite ? '取消收藏模板' : '收藏模板'}}">{{item.favorite ? '★' : '☆'}}</button>
        </view>
        <text class="card-subtitle">{{ item.subtitle }}</text>
        
        <view class="card-action-bar">
          <text class="card-cost">{{ item.costText || '按档位' }}</text>
          <text class="card-action-arrow">→</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 (当分类下无模板时) -->
  <view wx:if="{{ filteredTemplates.length === 0 && !loading && !loadError && loaded && !preferencesLoading && !(preferencesError && preferenceMode !== 'all') }}" class="empty-state">
    <text class="empty-icon">◌</text>
    <text class="empty-title">{{ searchQuery ? '没有找到匹配模板' : (preferenceMode === 'favorites' ? '还没有收藏的模板' : (preferenceMode === 'recent' ? '还没有最近使用记录' : '当前分类暂无模板')) }}</text>
    <text class="empty-sub">{{ searchQuery ? '试试更短的关键词，或切换到全部风格' : (preferenceMode === 'favorites' ? '点击模板右侧的星标，下次更容易找到' : (preferenceMode === 'recent' ? '成功提交模板创作后，它会出现在这里' : '试试其他分类，或稍后再来看看')) }}</text>
  </view>

  <!-- 底部风格说明注记 -->
  <view class="catalog-footer">
    <view class="footer-divider"></view>
    <text class="footer-note">示例供风格参考，生成效果因原图而异</text>
    <text class="footer-sub">请勿上传违规内容；审核违规不予生图并扣点，7天内累计3次将永久封禁，剩余点数不退还。</text>
  </view>

  <!-- 模板装裱详情模态框 (点击卡片展开) -->
  <view wx:if="{{ selectedItem }}" class="modal-backdrop" bindtap="onCloseDetail">
    <view class="modal-card gallery-card detail-modal" catchtap="true">
      <view class="washi-tape"></view>

      <view class="detail-header">
        <view class="detail-tags">
          <text class="detail-group-pill">{{ selectedItem.group_name || '风格工坊' }}</text>
          <text class="detail-engine-pill">{{ selectedItem.engine === 'fine' ? '2K精细超分' : '1.5K轻量增强' }}</text>
        </view>
        <text class="modal-close" bindtap="onCloseDetail">✕</text>
      </view>

      <scroll-view class="detail-scroll" scroll-y>
        <view class="detail-cover-stage">
          <swiper
            wx:if="{{ selectedItem.covers && selectedItem.covers.length > 1 }}"
            class="detail-stage-swiper"
            circular
            indicator-dots
            indicator-color="rgba(255,255,255,0.4)"
            indicator-active-color="#ffffff"
          >
            <swiper-item wx:for="{{ selectedItem.covers }}" wx:key="*this">
              <image
                class="detail-stage-img"
                src="{{ item }}"
                mode="aspectFit"
                bindtap="onPreviewCovers"
                data-url="{{ item }}"
              ></image>
            </swiper-item>
          </swiper>
          <image
            wx:else
            class="detail-stage-img"
            src="{{ selectedItem.coverUrl || '/images/logo.jpg' }}"
            mode="aspectFit"
            bindtap="onPreviewCovers"
            data-url="{{ selectedItem.coverUrl }}"
          ></image>
          <view class="stage-price-badge" wx:if="{{ selectedItem.price > 0 }}">
            <text>✦ {{ selectedItem.price }} 光子</text>
          </view>
          <view class="stage-price-badge stage-price-free" wx:else>
            <text>按档位计费</text>
          </view>
        </view>

        <view class="detail-body">
          <text class="detail-title">{{ selectedItem.name }}</text>
          <text class="detail-subtitle">{{ selectedItem.subtitle }}</text>

          <view class="detail-info-card">
            <view class="info-metric">
              <text class="metric-label">重构模式</text>
              <text class="metric-value">{{ selectedItem.engine === 'fine' ? '深度纹理超分' : '光影结构重绘' }}</text>
            </view>
            <view class="info-metric">
              <text class="metric-label">消耗光子</text>
              <text class="metric-value metric-gold">('✦ ' + selectedItem.price + ' 光子')</text>
            </view>
            <view class="info-metric">
              <text class="metric-label">排版特性</text>
              <text class="metric-value">{{ selectedItem.layout ? '支持日签排版' : '原画全幅装裱' }}</text>
            </view>
          </view>

          <!-- 选图指南（后台可编辑） -->
          <block wx:if="{{ selectedItem.guide && (selectedItem.guide.advice || selectedItem.guide.suitable.length || selectedItem.guide.unsuitable.length || selectedItem.guide.tips.length) }}">
            <view wx:if="{{ selectedItem.guide.advice }}" class="guide-advice-block">
              <text class="guide-advice-tag">选图建议</text>
              <text class="guide-advice-text">{{ selectedItem.guide.advice }}</text>
            </view>

            <view wx:if="{{ selectedItem.guide.suitable.length }}" class="guide-card">
              <view class="guide-card-head">
                <text class="guide-dot guide-dot-good">●</text>
                <text class="guide-card-title">适合这些照片</text>
              </view>
              <view wx:for="{{ selectedItem.guide.suitable }}" wx:key="*this" class="guide-li">
                <text class="guide-num guide-num-good">{{ index + 1 }}</text>
                <text class="guide-li-text">{{ item }}</text>
              </view>
            </view>

            <view wx:if="{{ selectedItem.guide.unsuitable.length }}" class="guide-card">
              <view class="guide-card-head">
                <text class="guide-dot guide-dot-bad">—</text>
                <view>
                  <text class="guide-card-title">不太适合</text>
                  <text class="guide-card-sub">建议换一张照片或选择其他风格</text>
                </view>
              </view>
              <view wx:for="{{ selectedItem.guide.unsuitable }}" wx:key="*this" class="guide-li">
                <text class="guide-num guide-num-gray">{{ index + 1 }}</text>
                <text class="guide-li-text">{{ item }}</text>
              </view>
            </view>

            <view wx:if="{{ selectedItem.guide.tips.length }}" class="guide-card">
              <view class="guide-card-head">
                <text class="guide-dot guide-dot-info">i</text>
                <view>
                  <text class="guide-card-title">上传前这样选</text>
                  <text class="guide-card-sub">简单检查一下原图</text>
                </view>
              </view>
              <view wx:for="{{ selectedItem.guide.tips }}" wx:key="*this" class="guide-li">
                <text class="guide-num guide-num-gray">{{ index + 1 }}</text>
                <text class="guide-li-text">{{ item }}</text>
              </view>
            </view>

            <text class="guide-fineprint">合适的原图能明显提高生成稳定性，但 AI 作品仍会保留一定随机变化。</text>
          </block>

          <text class="guide-fineprint">上传违规内容将扣除本次点数且不予生图；7天内累计3次将永久封禁。</text>
          <button class="btn-ink apply-btn" bindtap="onApplyTemplate">
            选用此风格，开始创作 →
          </button>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
