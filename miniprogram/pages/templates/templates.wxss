.page-container {
  background-color: var(--paper-bg);
  min-height: 100vh;
  padding: 30rpx 32rpx 60rpx;
  display: flex;
  flex-direction: column;
}

/* 顶部导语 */
.catalog-header {
  margin-bottom: 28rpx;
}

.catalog-eyebrow {
  display: block;
  font-family: var(--font-mono);
  font-size: 20rpx;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  color: var(--accent-gold);
  margin-bottom: 8rpx;
}

.catalog-headline {
  display: block;
  font-family: var(--font-serif);
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ink-title);
  letter-spacing: 1rpx;
}

.catalog-desc {
  display: block;
  font-size: 22rpx;
  color: var(--ink-muted);
  margin-top: 8rpx;
}

/* 分类胶囊栏 */
.category-bar {
  display: flex;
  flex-direction: row;
  white-space: nowrap;
  width: 100%;
  margin-bottom: 32rpx;
  padding-bottom: 8rpx;
}

.cat-chip {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  background: #ffffff;
  border: 1rpx solid var(--paper-border);
  color: var(--ink-muted);
  font-size: 24rpx;
  transition: all 0.2s ease;
}

.cat-chip-active {
  background: var(--ink-title);
  border-color: var(--ink-title);
  color: #f7f4ed;
  box-shadow: 0 4rpx 12rpx rgba(26, 25, 23, 0.12);
}

.cat-chip-text {
  font-weight: 500;
}

.cat-chip-count {
  font-size: 20rpx;
  opacity: 0.8;
}

/* 模板双列网格 */
.templates-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.template-card {
  overflow: hidden;
  background: #ffffff;
  border: 1rpx solid var(--paper-border);
  display: flex;
  flex-direction: column;
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.template-card:active {
  transform: translateY(2rpx);
}

.card-cover-box {
  position: relative;
  width: 100%;
  height: 330rpx;
  background: #ece8df;
  overflow: hidden;
}

.card-cover-img {
  width: 100%;
  height: 100%;
  display: block;
}

.card-engine-badge {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  background: rgba(26, 25, 23, 0.78);
  color: #f7f4ed;
  font-size: 18rpx;
  padding: 4rpx 10rpx;
  border-radius: 2rpx;
  backdrop-filter: blur(4px);
}

.card-group-tag {
  position: absolute;
  bottom: 12rpx;
  left: 12rpx;
  background: rgba(255, 255, 255, 0.88);
  color: var(--ink-title);
  font-size: 18rpx;
  font-weight: 600;
  padding: 4rpx 12rpx;
  border: 1rpx solid var(--paper-border);
  border-radius: 2rpx;
}

.card-multi-badge {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  background: rgba(26, 25, 23, 0.72);
  color: #f7f4ed;
  font-size: 18rpx;
  font-weight: 500;
  padding: 4rpx 10rpx;
  border-radius: 2rpx;
  backdrop-filter: blur(4px);
}

.card-content {
  padding: 20rpx 18rpx;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.card-name-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 8rpx;
}

.card-name {
  font-family: var(--font-serif);
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink-title);
}

.card-cost {
  font-size: 18rpx;
  color: var(--accent-rust);
  font-weight: 600;
  white-space: nowrap;
}

.card-subtitle {
  font-size: 20rpx;
  color: var(--ink-muted);
  margin-top: 8rpx;
  line-height: 1.4;
  height: 56rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-action-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
  padding-top: 12rpx;
  border-top: 1rpx dashed var(--paper-border);
  color: var(--ink-title);
}

.card-action-label {
  font-size: 22rpx;
  font-weight: 600;
}

.card-action-arrow {
  font-size: 24rpx;
  color: var(--accent-gold);
}

/* 空状态 */
.empty-state {
  padding: 80rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.empty-icon {
  font-size: 64rpx;
  color: var(--ink-faint);
  margin-bottom: 16rpx;
}

.empty-title {
  font-family: var(--font-serif);
  font-size: 30rpx;
  color: var(--ink-body);
}

.empty-sub {
  font-size: 22rpx;
  color: var(--ink-muted);
  margin-top: 8rpx;
}

/* 底部注记 */
.catalog-footer {
  margin-top: 48rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.footer-divider {
  width: 80rpx;
  height: 2rpx;
  background: var(--paper-border-dark);
  margin-bottom: 12rpx;
}

.footer-note {
  font-size: 20rpx;
  color: var(--ink-muted);
  letter-spacing: 1rpx;
}

.footer-sub {
  font-size: 18rpx;
  color: var(--ink-faint);
}

/* 模态框与详情装裱抽屉 */
.modal-backdrop {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(26, 25, 23, 0.6);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 36rpx;
  backdrop-filter: blur(4px);
}

.detail-modal {
  width: 100%;
  max-width: 620rpx;
  padding: 36rpx 32rpx;
  display: flex;
  flex-direction: column;
}

.detail-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.detail-tags {
  display: flex;
  gap: 12rpx;
}

.detail-group-pill {
  font-size: 20rpx;
  background: var(--paper-bg);
  border: 1rpx solid var(--paper-border-dark);
  padding: 4rpx 14rpx;
  color: var(--ink-body);
  font-weight: 500;
}

.detail-engine-pill {
  font-size: 20rpx;
  background: var(--ink-title);
  color: #ffffff;
  padding: 4rpx 14rpx;
  font-weight: 500;
}

.modal-close {
  font-size: 32rpx;
  color: var(--ink-muted);
  padding: 8rpx 16rpx;
}

.detail-cover-stage {
  width: 100%;
  height: 420rpx;
  background: #ece8df;
  border: 1rpx solid var(--paper-border);
  overflow: hidden;
  margin-bottom: 24rpx;
}

.detail-stage-swiper {
  width: 100%;
  height: 100%;
}

.detail-stage-img {
  width: 100%;
  height: 100%;
  display: block;
}

.detail-body {
  display: flex;
  flex-direction: column;
}

.detail-title {
  font-family: var(--font-serif);
  font-size: 36rpx;
  font-weight: 700;
  color: var(--ink-title);
}

.detail-subtitle {
  font-size: 22rpx;
  color: var(--ink-muted);
  margin-top: 8rpx;
  line-height: 1.5;
}

.detail-info-card {
  margin: 24rpx 0;
  padding: 20rpx;
  background: var(--paper-card-subtle);
  border: 1rpx solid var(--paper-border);
  display: flex;
  justify-content: space-around;
}

.info-metric {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.metric-label {
  font-size: 18rpx;
  color: var(--ink-muted);
}

.metric-value {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--ink-title);
}

.metric-gold {
  color: var(--accent-rust);
}

.apply-btn {
  width: 100%;
  margin-top: 10rpx;
}

/* 选图指南（后台可编辑，模板详情页展示） */
.detail-scroll {
  flex: 1;
  min-height: 0;
  max-height: 72vh;
}

.stage-price-badge {
  position: absolute;
  top: 18rpx;
  right: 18rpx;
  padding: 6rpx 18rpx;
  background: rgba(20, 26, 43, 0.72);
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.stage-price-free {
  background: rgba(255, 255, 255, 0.86);
  color: var(--ink-body);
}

.detail-cover-stage {
  position: relative;
}

.guide-advice-block {
  margin-top: 22rpx;
}

.guide-advice-tag {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--accent-rust);
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
}

.guide-advice-text {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink-title);
  line-height: 1.65;
}

.guide-card {
  margin-top: 22rpx;
  border: 1rpx solid var(--paper-border);
  border-radius: 14rpx;
  background: var(--paper-card-subtle);
  padding: 22rpx 24rpx;
}

.guide-card-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.guide-dot {
  flex: none;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 700;
}

.guide-dot-good {
  background: var(--ink-title);
  color: #ffffff;
  font-size: 14rpx;
}

.guide-dot-bad {
  background: #d8d2c6;
  color: #ffffff;
}

.guide-dot-info {
  background: var(--accent-rust);
  color: #ffffff;
  font-style: italic;
}

.guide-card-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink-title);
}

.guide-card-sub {
  display: block;
  font-size: 20rpx;
  color: var(--ink-muted);
}

.guide-li {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 10rpx 0;
  border-top: 1rpx dashed var(--paper-border);
}

.guide-li:first-of-type {
  border-top: none;
}

.guide-num {
  flex: none;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  font-weight: 700;
  margin-top: 2rpx;
}

.guide-num-good {
  background: var(--accent-rust);
  color: #ffffff;
}

.guide-num-gray {
  background: #d8d2c6;
  color: #ffffff;
}

.guide-li-text {
  flex: 1;
  font-size: 24rpx;
  color: var(--ink-body);
  line-height: 1.6;
}

.guide-fineprint {
  display: block;
  text-align: center;
  font-size: 20rpx;
  color: var(--ink-faint);
  margin-top: 24rpx;
}
