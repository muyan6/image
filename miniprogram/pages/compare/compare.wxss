page {
  background-color: #171614;
  height: 100vh;
  overflow: hidden;
}

.compare-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  width: 100vw;
  background-color: #171614;
}

/* 顶部策展导航栏 */
.gallery-nav {
  height: 100rpx;
  background: rgba(23, 22, 20, 0.95);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  z-index: 100;
}

.nav-back {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #f5f2eb;
}

.back-glyph {
  font-size: 44rpx;
  font-weight: 300;
  line-height: 40rpx;
}

.nav-spec {
  border: 1rpx solid rgba(222, 184, 123, 0.4);
  padding: 4rpx 18rpx;
  background: rgba(255, 255, 255, 0.04);
}

.spec-label {
  font-family: var(--font-mono);
  font-size: 20rpx;
  color: #deb87b;
  letter-spacing: 2rpx;
}

.quick-export {
  padding: 6rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

/* 观览台主体 */
.gallery-stage {
  flex: 1;
  position: relative;
  overflow: hidden;
  background-color: #11100f;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mat-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

/* 原画遮罩层：靠 overflow:hidden + 自身宽度做裁切。
   不能用 clip-path —— 裁剪后可见区域变窄，内核会以可见宽度为基准
   重新计算内层 image 的 aspectFit 缩放，导致原图比结果图小一圈、
   左右两半构图对不上。宽度由内联 style 的 splitPercent% 控制。 */
.clip-mat {
  position: absolute;
  top: 0;
  left: 0;
  height: 100%;
  overflow: hidden;
  pointer-events: none;
  z-index: 10;
  background-color: #11100f;
}

/* 内层原画：宽度由内联 style 注入舞台实测像素值，高度撑满遮罩层。
   于是它的 aspectFit 盒子 = 底层结果图的盒子（都是整块舞台），
   两张图缩放比例与居中偏移完全一致，实现像素级对齐。 */
.mat-image-locked {
  position: absolute;
  top: 0;
  left: 0;
  height: 100%;
}

/* 浮动典藏标牌 */
.floating-tag {
  position: absolute;
  top: 24rpx;
  z-index: 30;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  background: rgba(23, 22, 20, 0.8);
  backdrop-filter: blur(8px);
  padding: 8rpx 18rpx;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  pointer-events: none;
  transition: opacity 0.25s ease;
}

.tag-serif {
  font-family: var(--font-serif);
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #f5f2eb;
}

.tag-before {
  left: 24rpx;
}

.tag-after {
  right: 24rpx;
}

.tag-faded {
  opacity: 0.15;
}

/* 分割线与金属印章手柄 */
.slider-wire {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 2rpx;
  background: rgba(245, 242, 235, 0.85);
  box-shadow: 0 0 12rpx rgba(222, 184, 123, 0.5);
  z-index: 20;
  transform: translateX(-50%);
  pointer-events: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.wire-seal {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #f5f2eb;
  border: 2rpx solid #b38b4d;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.seal-arrow {
  font-size: 26rpx;
  color: #1a1917;
  font-weight: 700;
  line-height: 26rpx;
}

.seal-dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #b38b4d;
}

/* 长按检视胶囊 */
.hold-capsule {
  position: absolute;
  bottom: 30rpx;
  z-index: 30;
  background: rgba(23, 22, 20, 0.85);
  backdrop-filter: blur(12px);
  border: 1rpx solid rgba(222, 184, 123, 0.5);
  padding: 12rpx 28rpx;
  transition: all 0.15s ease;
}

.capsule-held {
  background: #b38b4d;
  border-color: #f5f2eb;
}

.capsule-held .typewriter-label {
  color: #1a1917;
  font-weight: 700;
}

/* 底部操作坞 */
.gallery-dock {
  height: 140rpx;
  background: rgba(23, 22, 20, 0.98);
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx 16rpx;
  gap: 20rpx;
  z-index: 100;
}

.dock-btn {
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  color: #f5f2eb;
  padding: 22rpx 32rpx;
  border-radius: 0;
  background: transparent;
}

.dock-btn-save {
  flex: 1;
  height: 88rpx;
  border-radius: 0;
  background: #f5f2eb;
  border: 1rpx solid #b38b4d;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.3);
}

.dock-save-text {
  font-family: var(--font-serif);
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #1a1917;
}
.media-notice {
  position: absolute;
  top: 45%;
  width: 44%;
  padding: 20rpx;
  box-sizing: border-box;
  background: rgba(20, 19, 16, 0.9);
  color: #dfcfb0;
  font-size: 24rpx;
  text-align: center;
  z-index: 15;
}
.media-notice text { display: block; margin: 10rpx 0; }
.media-notice-result { right: 2%; }
.media-notice-original { left: 2%; }
.media-loading { position: absolute; top: 42%; width: 100%; text-align: center; color: #dfcfb0; z-index: 14; }
