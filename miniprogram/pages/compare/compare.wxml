<view class="compare-page">
  <!-- 顶部策展画廊导航栏 -->
  <view class="gallery-nav">
    <view class="nav-back" bindtap="onClose">
      <text class="back-glyph">‹</text>
      <text class="typewriter-label">ARCHIVE</text>
    </view>

    <view class="nav-spec">
      <text class="spec-label">{{ label }}</text>
    </view>

    <view class="quick-export" bindtap="onDownload">
      <text class="typewriter-label">EXPORT</text>
    </view>
  </view>

  <!-- 艺术画廊观览台 (Core Stage) -->
  <view
    class="gallery-stage"
    id="stage"
    bindtouchstart="onTouchStart"
    bindtouchmove="onTouchMove"
    bindtouchend="onTouchEnd"
  >
    <!-- 底层：重构后的超高清艺术大画 -->
    <image
      class="mat-image"
      src="{{ resultUrl }}"
      mode="aspectFit"
      binderror="onResultError"
    ></image>

    <view class="media-notice media-notice-result" wx:if="{{ resultError }}" catchtap="onRetryMedia">
      <text>{{ resultError }}</text><text>点击重新加载</text>
    </view>
    <view class="media-loading" wx:if="{{ loadingMedia && !resultUrl }}"><text>正在加载图片…</text></view>

    <!-- 顶层：原画裁剪遮罩层
         用 overflow:hidden 限宽裁切，内层原画锁定为整个舞台的实测像素尺寸，
         与底层结果图共用同一个 aspectFit 缩放基准，杜绝对比滑块左右错位。 -->
    <view
      class="clip-mat"
      wx:if="{{ !textGenerated }}"
      style="width: {{ isPressingOriginal ? 100 : splitPercent }}%;"
    >
      <image
        class="mat-image mat-image-locked"
        style="width: {{ stageW }}px;"
        src="{{ originalUrl }}"
        mode="aspectFit"
        binderror="onOrigError"
      ></image>
    </view>

    <view class="media-notice media-notice-original" wx:if="{{ originalError }}" catchtap="onRetryMedia">
      <text>{{ originalError }}</text><text>点击重新加载</text>
    </view>

    <!-- 浮动典藏标签 -->
    <view wx:if="{{ !textGenerated }}" class="floating-tag tag-before {{ isDragging ? 'tag-faded' : '' }}">
      <text class="tag-serif">BEFORE</text>
      <text class="typewriter-label">{{ originalUnavailable ? '原图已到期' : (originalCompressed ? '对比原图 · 压缩版' : '原始样张') }}</text>
    </view>
    <view class="floating-tag tag-after {{ isDragging ? 'tag-faded' : '' }}">
      <text class="tag-serif">AFTER</text>
      <text class="typewriter-label">{{ textGenerated ? '文字生图成品' : '典藏重构' }}</text>
    </view>

    <!-- 分割线与双向金环手柄 -->
    <view
      class="slider-wire"
      wx:if="{{ !textGenerated }}"
      style="left: {{ splitPercent }}%;"
      hidden="{{ isPressingOriginal }}"
    >
      <view class="wire-seal">
        <text class="seal-arrow">‹</text>
        <view class="seal-dot"></view>
        <text class="seal-arrow">›</text>
      </view>
    </view>

    <!-- 长按即时检视原画胶囊 -->
    <view
      class="hold-capsule {{ isPressingOriginal ? 'capsule-held' : '' }}"
      wx:if="{{ !textGenerated }}"
      catchtouchstart="onPressOriginalStart"
      catchtouchend="onPressOriginalEnd"
    >
      <text class="typewriter-label">{{ originalUnavailable ? '[ 原图已到期 · 当前展示结果 ]' : (isPressingOriginal ? '[ INSPECTING ORIGINAL · 原始画质 ]' : '[ HOLD TO INSPECT ORIGINAL · 按住检视原画 ]') }}</text>
    </view>
  </view>

  <!-- 底部典藏导出底栏 -->
  <view class="gallery-dock">
    <view class="btn-line dock-btn" bindtap="onChangePhoto">
      <text class="typewriter-label">← NEW SPECIMEN</text>
    </view>

    <view class="btn-ink dock-btn-save" bindtap="onDownload">
      <text class="dock-save-text">EXPORT MASTER ── 保存典藏大片</text>
    </view>
  </view>
</view>
