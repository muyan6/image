<view class="page-container">
  <!-- 1. 顶部奖励黑曜石卡片 -->
  <view class="reward-card">
    <text class="card-eyebrow">INVITE REWARDS · 典藏奖励</text>
    <view class="reward-num-row">
      <text class="reward-plus">+</text>
      <text class="reward-number">50</text>
      <text class="reward-unit">积分 / 位</text>
    </view>
    <text class="reward-sub">好友通过邀请进入并完成首次成功拯救，你获得 50 积分，对方额外获赠 30 积分。</text>

    <view class="code-pill" bindtap="onCopyCode">
      <text class="code-text">{{ inviteCode }}</text>
      <text class="code-copy-btn">复制</text>
    </view>
  </view>

  <!-- 2. 统计指标条 -->
  <view class="stats-row gallery-card">
    <view class="stat-col">
      <text class="stat-val">0</text>
      <text class="stat-lbl">已奖励</text>
    </view>
    <view class="stat-sep"></view>
    <view class="stat-col">
      <text class="stat-val">1</text>
      <text class="stat-lbl">待完成</text>
    </view>
    <view class="stat-sep"></view>
    <view class="stat-col">
      <text class="stat-val">0</text>
      <text class="stat-lbl">累计积分</text>
    </view>
  </view>

  <!-- 3. 邀请明细 -->
  <view class="section-box">
    <text class="section-title">邀请明细</text>
    <view class="invite-list gallery-card">
      <view class="invite-item">
        <view class="inv-user-box">
          <image class="inv-avatar" src="/images/logo.jpg" mode="aspectFill"></image>
          <view class="inv-meta">
            <text class="inv-name">微信好友</text>
            <text class="inv-date">2026 年 9 月 28 日</text>
          </view>
        </view>
        <text class="inv-status-tag">待首次成功生成</text>
      </view>
    </view>
  </view>

  <!-- 4. 说明文案 -->
  <text class="rule-hint">奖励每天最多计入 10 位、每月最多计入 100 位有效好友。同一设备或异常刷量邀请不会发放奖励。</text>

  <!-- 5. 底部固定主行动按钮 -->
  <view class="bottom-action-bar">
    <button class="btn-ink invite-main-btn" open-type="share">
      邀请好友加入新生
    </button>
  </view>
</view>
