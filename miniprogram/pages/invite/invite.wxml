<view class="page-container">
  <!-- 1. 顶部奖励黑曜石卡片 -->
  <view class="reward-card">
    <text class="card-eyebrow">INVITE REWARDS · 典藏奖励</text>
    <view class="reward-num-row">
      <text class="reward-plus">✦</text>
      <text class="reward-number">30</text>
      <text class="reward-unit">光子 / 位</text>
    </view>
    <text class="reward-sub">好友填写你的邀请码即生效：你获得 30 光子，对方也获赠 30 光子（每人限参与一次）。</text>

    <view class="code-pill" bindtap="onCopyCode">
      <text class="code-text">{{ inviteCode || (inviteError ? '邀请码获取失败' : '正在获取邀请码') }}</text>
      <text class="code-copy-btn">{{ inviteCode ? '复制' : '重试' }}</text>
    </view>
  </view>

  <!-- 邀请统计与明细尚无服务端接口，不展示虚构数量或记录。 -->
  <view class="section-box">
    <text class="section-title">邀请明细</text>
    <view class="invite-list gallery-card">
      <view class="invite-item">
        <text>当前暂不展示邀请明细；绑定成功的奖励以光子余额为准。</text>
      </view>
    </view>
  </view>

  <text class="rule-hint">每位新用户仅可绑定一次邀请码；绑定成功后双方各获 30 光子。</text>

  <!-- 5. 底部固定主行动按钮 -->
  <view class="bottom-action-bar">
    <button class="btn-ink invite-main-btn" open-type="share">
      邀请好友加入新生
    </button>
  </view>
</view>
