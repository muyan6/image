<view class="page-container">
  <!-- 1. 顶部奖励黑曜石卡片 -->
  <view class="reward-card">
    <text class="card-eyebrow">INVITE REWARDS · 典藏奖励</text>
    <view class="reward-num-row">
      <text class="reward-plus">✦</text>
      <text class="reward-number">{{ inviteReward }}</text>
      <text class="reward-unit">光子 / 位</text>
    </view>
    <text class="reward-sub">好友填写你的邀请码即生效：你和对方各获 {{ inviteReward }} 光子（每人限参与一次）。</text>

    <view class="code-pill" bindtap="onCopyCode">
      <text class="code-text">{{ inviteCode || (inviteError ? '邀请码获取失败' : '正在获取邀请码') }}</text>
      <text class="code-copy-btn">{{ inviteCode ? '复制' : '重试' }}</text>
    </view>
  </view>

  <view wx:if="{{recordsLoaded}}" class="stats-row"><view class="stat-col"><text class="stat-val">{{total}}</text><text class="stat-lbl">成功邀请</text></view><view class="stat-sep"></view><view class="stat-col"><text class="stat-val">{{recordedReward}}</text><text class="stat-lbl">{{historicalUnknown ? '已记录奖励光子' : '累计奖励光子'}}</text></view></view>
  <view class="section-box">
    <text class="section-title">邀请明细</text>
    <view wx:if="{{recordsError}}" class="ui-state"><text>{{recordsError}}</text><button class="ui-state-action" bindtap="onRetryRecords">重新加载</button></view>
    <view class="invite-list gallery-card">
      <view wx:for="{{records}}" wx:key="id" class="invite-item"><view class="inv-meta"><text class="inv-name">{{item.nickname}}</text><text class="inv-date">{{item.dateLabel}} · 绑定成功</text></view><view class="inv-reward"><text class="inv-status-tag">{{item.reward === null ? '已到账' : '+' + item.reward + ' 光子'}}</text><text wx:if="{{item.reward === null}}" class="inv-date">历史金额未记录</text><text wx:else class="inv-date">奖励已到账</text></view></view>
      <view wx:if="{{!records.length && recordsLoaded && !recordsError && !recordsLoading}}" class="invite-item invite-empty"><text>还没有成功邀请记录，分享邀请码邀请好友吧。</text></view>
      <view wx:if="{{recordsLoading && !records.length}}" class="invite-item invite-empty"><text>正在读取邀请明细…</text></view>
    </view>
    <button wx:if="{{hasMore}}" class="ui-state-action" loading="{{recordsLoading}}" bindtap="onMoreRecords">查看更多邀请</button>
    <text wx:if="{{historicalUnknown}}" class="rule-hint">有 {{historicalUnknown}} 条历史记录未保存奖励金额，不按当前奖励推算；原有余额不受影响。</text>
  </view>

  <text class="rule-hint">每位新用户仅可绑定一次邀请码；绑定成功后双方各获 {{ inviteReward }} 光子。</text>

  <!-- 5. 底部固定主行动按钮 -->
  <view class="bottom-action-bar">
    <button class="btn-ink invite-main-btn" open-type="share">
      邀请好友加入
    </button>
  </view>
</view>
