<view class="page-container">
  <!-- 1. 用户身份档案卡 (Artist Dossier Card) -->
  <view class="user-card gallery-card">
    <view class="user-main">
      <view class="avatar-wrap">
        <image class="user-avatar" src="{{ avatarUrl || '/images/logo.jpg' }}" mode="aspectFill"></image>
      </view>
      <view class="user-info">
        <text class="user-name">{{ nickName || '微信用户' }}</text>
        <view class="user-id-row" bindtap="onCopyUserId">
          <text class="user-id-text">ID {{ userId }}</text>
          <text class="user-copy-tag">复制</text>
        </view>
      </view>
    </view>
    <view class="user-arrow" bindtap="onEditProfile">›</view>
  </view>

  <!-- 2. 可用光子黑卡 (Studio Pass Black Card) -> 点击进入二级页面【光子中心】 -->
  <view class="credit-black-card" bindtap="onGoCredits">
    <view class="black-card-bg-mark">新生</view>
    <view class="black-card-top">
      <text class="black-card-label">可用光子</text>
      <view class="black-card-link">
        <text>光子中心</text>
        <text class="black-card-arrow">›</text>
      </view>
    </view>
    <view class="black-card-balance">
      <text class="balance-num">✦ {{ lightPoints }}</text>
      <text class="balance-unit">光子</text>
    </view>
    <view class="black-card-foot">
      <text class="black-card-status">{{ freeMode ? '全站免费体验中 · 无限制' : ('轻量消耗 ✦' + priceLight + ' · 精细消耗 ✦' + priceFine) }}</text>
    </view>
  </view>

  <!-- 3. 数据指标条 (3 列数据) -> 点击分别跳二级页面 -->
  <view class="stats-card gallery-card">
    <view class="stat-col" bindtap="onGoWorks">
      <text class="stat-number">{{ historyList.length }}</text>
      <text class="stat-label">作品</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-col" bindtap="onGoWorks">
      <text class="stat-number">{{ processingCount }}</text>
      <text class="stat-label">生成中</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-col" bindtap="onGoCredits">
      <text class="stat-number">{{ creditRecordCount }}</text>
      <text class="stat-label">光子记录</text>
    </view>
  </view>

  <!-- 4. 看视频补给任务卡 (Video Bonus Card)
       仅在后台配好激励视频广告位时显示（config.ads.rewarded_video_ready）。
       未配置 = 不显示入口，也就不会出现"点一下光子直接到账"。 -->
  <view wx:if="{{ videoAdReady }}" class="task-card gallery-card">
    <view class="task-left">
      <view class="task-play-icon">
        <text class="play-triangle">▶</text>
      </view>
      <view class="task-info">
        <text class="task-title">看视频得光子</text>
        <text class="task-desc">完整观看一次 +✦10 光子</text>
        <text class="task-progress">今日 {{ videoTasksToday }}/{{ maxVideoTasks }}</text>
      </view>
    </view>
    <button
      class="btn-ink task-btn {{ videoTasksToday >= maxVideoTasks ? 'task-btn-disabled' : '' }}"
      bindtap="onWatchVideo"
    >
      {{ videoTasksToday >= maxVideoTasks ? '已领完' : '观看' }}
    </button>
  </view>

  <!-- 5. 我的作品展区 -> 点击进入二级页面【我的作品】 -->
  <view class="works-section">
    <view class="section-header">
      <view class="section-title-wrap">
        <text class="section-title">我的作品</text>
      </view>
      <view class="section-more-link" bindtap="onGoWorks" wx:if="{{ historyList.length > 0 }}">
        <text>全部作品 ({{ historyList.length }})</text>
        <text class="more-arrow">›</text>
      </view>
    </view>

    <!-- 有作品时：双列/三列优雅缩略预览，点击进入二级作品展 -->
    <view wx:if="{{ historyList.length > 0 }}" class="works-preview-grid" bindtap="onGoWorks">
      <view
        wx:for="{{ previewWorks }}"
        wx:key="jobId"
        class="work-card gallery-card"
      >
        <image class="work-thumb" src="{{ item.result }}" mode="aspectFill"></image>
        <view class="work-tag">
          <text>{{ item.quality === 'fine' ? '2K精细' : '1.5K' }}</text>
        </view>
      </view>
    </view>

    <!-- 作品空状态 -->
    <view wx:else class="works-empty gallery-card">
      <text class="empty-text">还没有作品。完成一次创作后，它会出现在这里。</text>
      <button class="btn-line empty-action-btn" bindtap="onGoCreate">
        去创作第一张照片 →
      </button>
    </view>
  </view>

  <!-- 6. 服务与设置菜单列表 (全部导航到二级页面) -->
  <view class="menu-card gallery-card">
    <view class="menu-item" bindtap="onGoCredits">
      <text class="menu-label">光子与订单</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-divider"></view>

    <view class="menu-item" bindtap="onGoInvite">
      <text class="menu-label">邀请记录</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-divider"></view>

    <view class="menu-item" bindtap="onGoPrivacy">
      <text class="menu-label">隐私说明</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-divider"></view>

    <view class="menu-item" bindtap="onGoRetention">
      <text class="menu-label">照片保存期限</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-divider"></view>

    <view class="menu-item" bindtap="onContactSupport">
      <text class="menu-label">联系客服与反馈</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-divider"></view>

    <view class="menu-item menu-item-danger" bindtap="onClearStorage">
      <text class="menu-label menu-danger-text">清理缓存数据</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 底部微标 -->
  <view class="dossier-footer">
    <text class="dossier-brand">废片新生所 · 典藏个人档案</text>
    <text class="dossier-ver">VERSION 2.4 · 艺术策展引擎</text>
  </view>
</view>
