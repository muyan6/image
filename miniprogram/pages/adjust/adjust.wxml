<view class="container">
  <view class="ui-state" wx:if="{{ priceError }}" bindtap="loadUserData"><text>{{ priceError }}</text></view>
  <scroll-view class="scroll-content" scroll-y enable-flex>
    <!-- 顶部输出预览大图 (截图2) -->
    <view class="preview-stage-wrap">
      <view
        class="preview-stage ratio-{{ currentRatioKey }}"
        style="{{ previewStyle }}"
      >
        <image
          class="preview-img"
          src="{{ imagePath }}"
          mode="{{ selectedTemplate ? 'aspectFit' : 'aspectFill' }}"
        ></image>
        
        <!-- 比例角标 (右上角) -->
        <view class="badge-ratio">
          <text>{{ selectedTemplate ? '模板自由构图' : currentRatioLabel }}</text>
        </view>

        <!-- 底部水印标识 -->
        <view class="preview-bottom-bar">
          <text class="tag-left">{{ selectedTemplate ? '原始素材 · 成品按模板构图' : '取景预览' }}</text>
          <text class="tag-right">{{ selectedTemplate ? selectedTemplate.name : '原片修复' }}</text>
        </view>
      </view>
    </view>

    <!-- 卡片 1：画幅 (截图2) -->
    <view class="card-section" wx:if="{{ !selectedTemplate }}">
      <view class="section-header">
        <text class="section-title">画幅</text>
        <text class="section-headline">保持原图，或重新取景</text>
      </view>

      <view class="ratio-bar" bindtap="onOpenRatioModal">
        <text class="ratio-label">当前比例</text>
        <view class="ratio-val-group">
          <text class="ratio-val">{{ currentRatioLabel }}</text>
          <text class="pill-rec" wx:if="{{ currentRatioKey === 'original' }}">推荐</text>
          <text class="ratio-change-link">更改 ›</text>
        </view>
      </view>

      <text class="section-hint">选择非原图比例后，会按所选画幅居中裁切；模板生成不限制素材比例。</text>
    </view>

    <!-- 卡片 2：风格 / 选择表达方式 (截图3) -->
    <view class="card-section">
      <view class="section-header section-header-split">
        <view class="header-left">
          <text class="section-title">风格</text>
          <text class="section-headline">选择表达方式</text>
        </view>
        <view class="header-right">
          <text class="pill-tag">适用照片</text>
          <text class="price-range">{{ priceRangeText }}</text>
        </view>
      </view>

      <scroll-view class="styles-scroll" scroll-x enable-flex show-scrollbar="{{ false }}">
        <view
          wx:for="{{ allTemplates }}"
          wx:key="id"
          class="style-item {{ (!selectedTemplate && !item.id) || (selectedTemplate && selectedTemplate.id === item.id) ? 'style-item-active' : '' }}"
          bindtap="onSelectTemplate"
          data-template="{{ item }}"
        >
          <view class="style-cover-wrap">
            <image
              class="style-cover"
              src="{{ item.coverUrl || '/images/logo.jpg' }}"
              mode="aspectFill"
            ></image>
          </view>
          <text class="style-name">{{ item.name }}</text>
        </view>
      </scroll-view>
    </view>

    <view class="card-section" wx:if="{{ selectedTemplate }}">
      <view class="section-header">
        <text class="section-title">成品形式</text>
        <text class="section-headline">是否在成品中保留原图对比</text>
      </view>
      <view class="tier-grid output-grid">
        <view class="tier-card {{ templateOutputMode === 'template' ? 'tier-card-active' : '' }}"
          bindtap="onSelectTemplateOutput" data-mode="template">
          <view class="output-diagram output-diagram-pair" aria-hidden="true"><view>原图</view><view>效果</view></view>
          <text class="tier-name">按模板生成</text>
          <text class="tier-desc">遵循模板；有原图对比时保留拼接</text>
        </view>
        <view class="tier-card {{ templateOutputMode === 'single' ? 'tier-card-active' : '' }} {{ !singleOutputAvailable ? 'output-unavailable' : '' }}"
          bindtap="onSelectTemplateOutput" data-mode="single">
          <view class="output-diagram output-diagram-single" aria-hidden="true"><view>效果</view></view>
          <text class="tier-name">仅生成后图</text>
          <text class="tier-desc">{{ singleOutputAvailable ? '省略原图对比区域，保留生成后的画面' : '后端更新后启用' }}</text>
        </view>
      </view>
      <text class="section-hint">示意仅用于区分原图对比，不代表每个模板都会拼接。此选项不影响费用。</text>
      <view class="output-help-toggle" bindtap="onToggleOutputHelp">{{ showOutputHelp ? '收起说明 ∧' : '两种形式有什么区别？ ›' }}</view>
      <text wx:if="{{ showOutputHelp }}" class="section-hint">不含原图对比的模板，两项效果通常相同，保留原有构图、文字与装饰。这是生成时的要求，不会自动裁切，也不是从已有拼图中精确提取，实际效果仍取决于模型。</text>
    </view>

    <!-- 卡片 3：生成档位 / 选择这次的生成方式 -->
    <view class="card-section">
      <view class="section-header section-header-split">
        <view class="header-left">
          <text class="section-title">生成档位</text>
          <text class="section-headline">选择这次的生成方式</text>
        </view>
        <view class="header-right">
          <text class="current-cost-text">✦ {{ currentQualityCost }} 光子</text>
        </view>
      </view>

      <!-- 模板和原片修复都可选择两档，使用同一价格 -->
      <view class="tier-grid">
        <!-- 轻量生成 -->
        <view
          class="tier-card {{ quality === 'light' ? 'tier-card-active' : '' }}"
          bindtap="onSelectQuality"
          data-quality="light"
        >
          <view class="tier-card-top">
            <text class="tier-name">轻量生成</text>
            <text class="tier-price">✦ {{ costLight }} 光子</text>
          </view>
          <text class="tier-desc">速度优先，适合日常创作</text>
        </view>

        <!-- 精细生成 -->
        <view
          class="tier-card {{ quality === 'fine' ? 'tier-card-active' : '' }}"
          bindtap="onSelectQuality"
          data-quality="fine"
        >
          <view class="tier-card-top">
            <text class="tier-name">精细生成</text>
            <text class="tier-price">✦ {{ costFine }} 光子</text>
          </view>
          <text class="tier-desc">细节优先，适合精细创作</text>
        </view>
      </view>
    </view>

    <!-- 原片修复自定义需求 -->
    <text class="section-hint" wx:if="{{ selectedTemplate && !templateTiersAvailable }}">当前后端尚未支持模板双档，请更新后端后生成。</text>
    <view class="card-section" wx:if="{{ !selectedTemplate }}">
      <view class="section-header prompt-toggle" bindtap="onToggleCustomPrompt">
        <text class="section-title">补充要求 · 可选</text>
        <text class="section-headline">{{ showCustomPrompt ? '收起补充要求 ∧' : '有明确修改需求再展开 ›' }}</text>
      </view>
      <text class="section-hint">不用填写，直接生成即可自动优化清晰度、曝光与色彩。</text>
      <block wx:if="{{ showCustomPrompt }}">
        <textarea class="custom-prompt-input" value="{{ customPrompt }}" maxlength="500"
          placeholder="输入明确请求，例如：移除背景中的路人，美化皮肤等"
          bindinput="onCustomPromptInput" />
        <text class="prompt-hint">不确定怎么写就留空。过多或相互冲突的要求可能降低效果；收起后不提交补充文字。</text>
      </block>
    </view>

    <!-- 卡片 4：模板自定义文字（代码叠加中文，保证文字正确） -->
    <view
      class="card-section"
      wx:if="{{ selectedTemplate && selectedTemplate.text_fields && selectedTemplate.text_fields.length > 0 }}"
    >
      <view class="section-header section-header-split">
        <view class="header-left">
          <text class="section-title">自定义文字</text>
          <text class="section-headline">生成后叠加在画面上</text>
        </view>
      </view>
      <view
        wx:for="{{ selectedTemplate.text_fields }}"
        wx:key="key"
        class="tpl-text-row"
      >
        <text class="tpl-text-label">{{ item.label }}</text>
        <input
          class="tpl-text-input"
          value="{{ textValues[item.key] }}"
          placeholder="{{ item.label }}"
          maxlength="{{ item.max_len }}"
          bindinput="onTextFieldInput"
          data-key="{{ item.key }}"
        />
      </view>
    </view>

    <!-- 版权与使用权勾选 (截图3) -->
    <view class="rights-card">
      <text class="violation-notice">请勿上传或输入违规内容。审核违规将不予生成并扣除本次点数；7天内累计3次将永久封禁账号，剩余点数不予退还。若有误判，可提交反馈复核。</text>
      <view class="rights-row" bindtap="onToggleRights">
        <view class="custom-checkbox {{ rightsOk ? 'checkbox-checked' : '' }}">
          <text class="checkbox-symbol" wx:if="{{ rightsOk }}">✓</text>
        </view>
        <view class="rights-text-col">
          <text class="rights-main">我拥有这张照片的使用权</text>
          <text class="rights-sub">请勿上传未经许可的私人照片或受限制内容。</text>
          <view class="protocol-links">
            <text class="link-item" catchtap="onOpenProtocol" data-type="service">服务协议</text>
            <text class="link-item" catchtap="onOpenProtocol" data-type="privacy">隐私指引</text>
            <text class="link-item" catchtap="onOpenProtocol" data-type="auth">照片授权</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 底部撑开空间 -->
    <view class="bottom-spacer"></view>
  </scroll-view>

  <!-- 底部固定吸底操作栏 -->
  <view class="fixed-bar">
    <view class="bar-credit-info">
      <text class="bar-balance">余额 {{ freeMode ? '不限' : '✦ ' + lightPoints }}</text>
      <text class="bar-deduct">{{ freeMode ? '体验免扣' : ('提交预扣 ✦' + currentQualityCost + ' 光子') }}</text>
    </view>
    <button class="btn-generate" bindtap="onStartGenerate" loading="{{ processing }}" disabled="{{ processing }}">
      开始生成
    </button>
  </view>

  <view class="violation-mask" wx:if="{{ showViolationNotice }}">
    <view class="violation-dialog" catchtap="true">
      <text class="violation-eyebrow">内容审核</text>
      <text class="violation-title">{{ violationDetail.banned ? '账号已被封禁' : '内容违规，未生成' }}</text>
      <text class="violation-message">{{ violationDetail.message }}</text>
      <view class="violation-stats">
        <text>本次扣除 ✦{{ violationDetail.charged || 0 }}</text>
        <text>近 7 天违规 {{ violationDetail.weekly_count || 0 }}/3 次</text>
      </view>
      <text class="violation-explain">{{ violationDetail.banned ? '账号已永久封禁，剩余点数不予退还。' : '一周内累计 3 次将永久封禁账号。若有误判，请联系在线客服。' }}</text>
      <view class="violation-actions">
        <button class="violation-secondary" bindtap="onSubmitViolationFeedback">误判反馈</button>
        <button class="violation-secondary" open-type="contact" session-from="violation-{{ violationId }}">联系客服</button>
        <button class="violation-primary" bindtap="onAcknowledgeViolation">我知道了</button>
      </view>
    </view>
  </view>

  <!-- 画幅比例选择弹窗抽屉 -->
  <view class="modal-mask" wx:if="{{ showRatioModal && !selectedTemplate }}" bindtap="onCloseRatioModal">
    <view class="ratio-sheet" catchtap="true">
      <view class="sheet-head">
        <text class="sheet-title">选择画幅比例</text>
        <text class="sheet-close" bindtap="onCloseRatioModal">✕</text>
      </view>
      <view class="ratio-options-list">
        <view
          wx:for="{{ ratioOptions }}"
          wx:key="key"
          class="ratio-option-item {{ currentRatioKey === item.key ? 'ratio-option-active' : '' }}"
          bindtap="onSelectRatioOption"
          data-key="{{ item.key }}"
          data-label="{{ item.label }}"
        >
          <view class="option-left">
            <text class="option-name">{{ item.label }}</text>
            <text class="option-desc">{{ item.desc }}</text>
          </view>
          <view class="option-badge" wx:if="{{ item.rec }}">
            <text>推荐</text>
          </view>
          <text class="option-check" wx:if="{{ currentRatioKey === item.key }}">✓</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 处理中遮罩/动画 -->
  <view class="processing-mask" wx:if="{{ processing }}">
    <view class="processing-box">
      <!-- 右上角允许随时关闭浮层 -->
      <view class="processing-close-btn" bindtap="onCancelOrMinimizeWait">✕</view>
      <view class="loading-ring"></view>
      <text class="processing-title">AI 重构进行中</text>
      <text class="processing-sub">{{ processingText }}</text>
      <text class="processing-tip">生成时间随模型和排队情况变化；提交后可到「作品」查看进度。</text>

      <!-- 快捷离开按钮（拿到任务ID后即可转后台） -->
      <view class="processing-actions" wx:if="{{ currentJobId }}">
        <button class="btn-leave-action" bindtap="onCancelOrMinimizeWait">
          稍后在「作品」查看 →
        </button>
      </view>
    </view>
  </view>
</view>
