.page-container {padding:40rpx 32rpx; background:#f5f2eb; min-height:100vh; box-sizing:border-box;}
.heading {display:block;font-size:44rpx;margin-bottom:16rpx;}
.intro,.hint {display:block;color:#8e887f;font-size:24rpx;line-height:1.7;margin:16rpx 0;}
.prompt-card {padding:28rpx;margin:30rpx 0;}
textarea {width:100%;min-height:280rpx;margin-top:20rpx;font-size:28rpx;box-sizing:border-box;}
.ratios {display:flex;gap:12rpx;margin-bottom:32rpx;}
.ratio {flex:1;text-align:center;padding:24rpx 0;border:1rpx solid #d8d0c2;border-radius:12rpx;font-size:24rpx;}
.active {border-color:#1a1917;background:#fffdf8;}
button {background:#1a1917;color:#fff;border-radius:14rpx;font-size:28rpx;}
.works-link {text-align:center;color:#8a6939;padding:30rpx 0;font-size:26rpx;}
